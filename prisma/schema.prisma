// =============================================================
//  CAP COMPÉTENCE MANAGER — Schéma de base de données (Prisma)
//  SaaS de gestion d'organisme de formation certifié Qualiopi.
//  PostgreSQL. Couvre les 16 modules fonctionnels.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
//  ENUMS
// =============================================================

enum Role {
  SUPERADMIN // éditeur de la plateforme (compte développeur, hors organisme)
  ADMIN
  RESPONSABLE_FORMATION
  ASSISTANT
  FORMATEUR
  APPRENANT
  ENTREPRISE
}

enum OrganismeStatut {
  ESSAI
  ACTIF
  SUSPENDU
}

// Formule d'abonnement vendue à l'organisme (cf. lib/plans.ts).
enum FormuleAbonnement {
  INDEPENDANT
  PRO
  CROISSANCE
  RESEAU
}

enum SupportPriorite {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum SupportStatut {
  OUVERT
  EN_COURS
  RESOLU
}

// Tenant : un organisme de formation client. Toutes les données « métier »
// seront rattachées à un Organisme (multi-tenant, cloisonnement par organismeId).
model Organisme {
  id String @id @default(cuid())

  // Identité & légal
  nom                 String // nom commercial
  raisonSociale       String?
  representant        String? // gérant : nom + prénom
  representantQualite String? // fonction/qualité (pour la signature des documents)
  siret               String?
  nda                 String? // n° de déclaration d'activité
  numeroTva           String?
  adresse             String?
  codePostal          String?
  ville               String?
  telephone           String?
  email               String?
  siteWeb             String?
  certificateur       String?
  qualiopiNumero      String?
  assujettiTva        Boolean @default(true)

  // Identité visuelle (data URL ou chemin)
  logoUrl           String? @db.Text
  cachetUrl         String? @db.Text
  signatureUrl      String? @db.Text
  faviconUrl        String? @db.Text
  couleurPrimaire   String? @default("#1A5FD4")
  couleurSecondaire String?
  theme             String? // (legacy) palette de couleur seule ; repli si design vide
  design            String? // habillage/skin choisi (cf. lib/themes.ts DESIGNS) : mode + surfaces + police + arrondi
  // Catalogue client : clients « externes » hébergés sur leur propre déploiement
  // (ex. ASPR Manager). appUrl = URL de l'app ; version = libellé de version/MAJ.
  appUrl            String?
  version           String?

  // Communication
  emailExpediteurNom String?
  emailExpediteur    String?
  brevoApiKey        String?
  sousDomaine        String? @unique
  // Code neutre unique de l'OF, préfixe des numéros de vérification des titres
  // (base de vérification unique, multi-tenant) → garantit l'unicité GLOBALE des
  // numéros entre clients. Auto-généré (of-code.ts), modifiable en console.
  codeVerification   String? @unique

  // Clés d'intégration PAR organisme (sinon repli sur la config globale)
  anthropicApiKey String? // Assistant IA (Claude) — génération de texte
  imageApiKey     String? // Images IA (visuels — module Communication)
  yousignApiKey   String? // signature électronique prestataire
  // Financements — clés d'intégration (chiffrées via lib/crypto).
  wedofApiKey        String? // Wedof/CertiPlace : suivi des dossiers CPF (EDOF)
  wedofWebhookSecret String? // secret de vérification des notifications Wedof
  // Matrice d'automatisations Brevo configurable : { "<event>": { on, channel, trigger } }
  automationsConfig Json?
  maxSmsMois        Int? // quota SMS / mois (selon formule)
  smsSolde          Int  @default(0) // solde SMS prépayé (packs) consommé en dépassement du quota

  // Fonctionnalités activées (clés de features cochées dans la console)
  fonctionnalites String[] @default([])

  // Choix des documents : { "reglement_interieur": "modele" | "client", ... }
  documentsConfig Json?

  // Configuration formations : slugs des formations qu'un organisme utilise (ex: ["ssiap-1-initial", "tfp-aps-cnaps"])
  // Vide = toutes les formations du catalogue (par défaut).
  configurationsFormations String[] @default([])

  // Pilotage SaaS (côté éditeur)
  statut          OrganismeStatut    @default(ESSAI)
  formule         FormuleAbonnement? // abonnement vendu (pilote la facturation + le bundle de features)
  maxUtilisateurs Int?
  notes           String?            @db.Text

  // Facturation Stripe (abonnement self-serve). Renseignés par le checkout +
  // le webhook ; vides tant que l'organisme n'a pas souscrit.
  stripeCustomerId     String? // client Stripe (1 par organisme ; pas de contrainte unique pour éviter une migration destructive)
  stripeSubscriptionId String?
  abonnementJusquau    DateTime? // fin de la période payée en cours (current_period_end)
  // Traçage de l'acceptation contractuelle au moment de la souscription (case cochée
  // par le gérant, documents publiés + liés). Horodatage de la DERNIÈRE acceptation ;
  // null tant que jamais souscrit. Le « qui » est journalisé dans AuditLog (action ACCEPT_CGV).
  cgvAcceptedAt             DateTime? // acceptation des CGV (/cgv)
  confidentialiteAcceptedAt DateTime? // acceptation de la politique de confidentialité (/confidentialite)

  // Conformité RGPD + accessibilité (Qualiopi ind. 26)
  dureeConservationMois  Int     @default(36) // durée de conservation des données candidats (mois) → purge auto
  referentHandicapNom    String? // référent handicap désigné par l'OF
  referentHandicapContact String? // e-mail / téléphone du référent handicap

  // Environnement de DÉMONSTRATION (provisionné automatiquement pour un prospect).
  // Un tenant démo est isolé, pré-rempli, bridé (pas d'envoi réel/facturation) et
  // expire : 48 h après la 1re connexion (demoExpiresAt, fixé au 1er login), avec
  // un filet de sécurité à J+7 (demoHardExpiresAt) si jamais connecté.
  isDemo            Boolean   @default(false)
  demoFirstLoginAt  DateTime? // 1re connexion → démarre le compteur 48 h
  demoExpiresAt     DateTime? // = demoFirstLoginAt + 48 h (null tant que jamais connecté)
  demoHardExpiresAt DateTime? // = createdAt + 7 j (filet de sécurité)

  users               User[]
  supportTickets      SupportTicket[]
  dossiersFinancement DossierFinancement[]
  contratsPrestation  ContratPrestation[]
  facturesEditeur     FactureEditeur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([isDemo])
}

// Contrat de PRESTATION éditeur ↔ OF client (abonnement OF Manager). À ne pas
// confondre avec `Contrat` (contrat de formation d'un candidat). Piloté depuis la
// console éditeur : devis (BROUILLON) → envoi (ENVOYE) → signature interne (SIGNE).
enum EngagementPrestation {
  MENSUEL
  ANNUEL
}

enum ContratPrestationStatut {
  BROUILLON
  ENVOYE
  SIGNE
  REFUSE
}

model ContratPrestation {
  id             String    @id @default(cuid())
  organismeId    String
  organisme      Organisme @relation(fields: [organismeId], references: [id], onDelete: Cascade)
  reference      String    @unique
  formule        FormuleAbonnement
  options        String[]  @default([]) // add-ons / modules vendus en plus
  engagement     EngagementPrestation    @default(MENSUEL)
  montantMensuel Decimal   @db.Decimal(10, 2)
  remisePct      Int       @default(0)
  packs          String[]  @default([]) // clés de packs métier (cf. lib/options)
  fraisMiseEnService Int?  // frais d'installation one-time (HT) ; 0 = offert
  pionnier       Boolean   @default(false) // offre de lancement « Pionniers »
  pionnierVariante String? // MENSUEL_6M | ANNUEL_12M_PREPAYE
  prixGele       Boolean   @default(false) // prix gelé à vie sur le palier souscrit
  dateDebut      DateTime?
  statut         ContratPrestationStatut @default(BROUILLON)
  // Signature électronique interne : lien public + tracé manuscrit + IP + horodatage.
  token         String?   @unique
  signataireNom String?
  signatureUrl  String?   @db.Text
  signatureIp   String?
  signedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([organismeId])
  @@index([statut])
}

// Facture ÉDITEUR → OF client (abonnement OF Manager). Conçue pour la réforme
// française de la facturation électronique (2026-2027) : mentions obligatoires
// (SIREN client, catégorie d'opération, TVA détaillée), statuts du cycle de vie
// (Déposée/Rejetée/Refusée/Encaissée) et format structuré EN 16931 / Factur-X.
enum FactureEditeurStatut {
  BROUILLON
  EMISE
  DEPOSEE // transmise à la plateforme partenaire (PDP)
  ENCAISSEE
  REJETEE
  REFUSEE
  AVOIR
}

enum CategorieOperation {
  BIENS
  SERVICES
  MIXTE
}

model FactureEditeur {
  id          String               @id @default(cuid())
  organismeId String // le CLIENT facturé
  organisme   Organisme            @relation(fields: [organismeId], references: [id], onDelete: Cascade)
  contratId   String? // contrat de prestation source (lien souple)
  numero      String?              @unique // n° séquentiel unique, attribué À L'ÉMISSION (null en brouillon → pas de trou dans la séquence)
  statut      FactureEditeurStatut @default(BROUILLON)
  categorie   CategorieOperation   @default(SERVICES)

  // Période facturée
  periodeDebut DateTime
  periodeFin   DateTime
  dateEmission DateTime?
  dateEcheance DateTime?

  // Montants (mentions obligatoires : HT, TVA détaillée, TTC)
  montantHT  Decimal @db.Decimal(10, 2)
  tauxTva    Decimal @default(20) @db.Decimal(5, 2)
  montantTva Decimal @db.Decimal(10, 2)
  montantTTC Decimal @db.Decimal(10, 2)
  lignes     Json // [{ libelle, quantite, prixUnitaire, montantHT }]

  // Mentions issues de la réforme e-invoicing 2026
  clientSiren      String? // SIREN du client (obligatoire dès 09/2026)
  adresseLivraison String? // si différente de l'adresse de facturation
  optionTvaDebits  Boolean @default(false)
  modePaiement     String? @default("Prélèvement SEPA")

  // Paiement & transmission
  paidAt        DateTime?
  pdpTransmisAt DateTime? // dépôt sur la plateforme partenaire (Lot 4c)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organismeId])
  @@index([statut])
}

// Dossier de financement d'une inscription (CPF via Wedof, ou OPCO en interne).
// Suit l'état côté financeur sans alourdir le modèle Inscription.
model DossierFinancement {
  id            String  @id @default(cuid())
  organismeId   String? // tenant
  organisme     Organisme? @relation(fields: [organismeId], references: [id], onDelete: Cascade)
  inscriptionId String?
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id], onDelete: SetNull)
  candidatId    String?
  candidat      Candidat? @relation(fields: [candidatId], references: [id], onDelete: SetNull)

  type      FinancementType // CPF, OPCO, FRANCE_TRAVAIL…
  financeur String? // "CPF" ou nom de l'OPCO (AKTO…)
  etat      DossierFinancementEtat @default(A_MONTER)
  montant   Decimal? @db.Decimal(10, 2)
  reference String? // n° de dossier interne

  // CPF — suivi via Wedof (registrationFolder)
  wedofId   String?   @unique // identifiant du dossier côté Wedof
  wedofEtat String? // état brut renvoyé par Wedof
  wedofMajLe DateTime? // dernière synchro Wedof

  // OPCO — géré en interne
  opcoNumero           String? // n° de dossier OPCO
  priseEnChargeMontant Decimal? @db.Decimal(10, 2)
  subrogation          Boolean  @default(false) // l'OPCO paie l'OF directement
  accordLe             DateTime? // date de l'accord de prise en charge
  bordereauUrl         String?  @db.Text // bordereau généré (PDF)

  notesJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organismeId])
  @@index([inscriptionId])
  @@index([candidatId])
  @@index([type, etat])
}

enum DossierFinancementEtat {
  A_MONTER   // à créer / à envoyer
  EN_COURS   // envoyé, en instruction
  ACCEPTE    // accord de prise en charge
  REFUSE
  A_FACTURER // service fait → facturer le financeur
  FACTURE
  SOLDE      // encaissé
  ANNULE
}

enum Modalite {
  PRESENTIEL
  DISTANCIEL
  MIXTE
}

enum Academy {
  DIGITAL
  SAFETY
