// =============================================================
//  CAP COMPÉTENCE MANAGER — Schéma de base de données (Prisma)
//  SaaS de gestion d'organisme de formation certifié Qualiopi.
//  PostgreSQL. Couvre les 16 modules fonctionnels.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
//  ENUMS
// =============================================================

enum Role {
  ADMIN
  RESPONSABLE_FORMATION
  ASSISTANT
  FORMATEUR
  APPRENANT
}

enum Modalite {
  PRESENTIEL
  DISTANCIEL
  MIXTE
}

enum Academy {
  DIGITAL
  SAFETY
  TRANSPORT
  LANGUE
}

enum FinancementType {
  CPF
  OPCO
  FRANCE_TRAVAIL
  AUTOFINANCEMENT
  ENTREPRISE
  AUTRE
}

enum CandidatStatut {
  NOUVEAU
  EN_TRAITEMENT
  INSCRIT
  REFUSE
  ARCHIVE
}

enum SessionStatut {
  PLANIFIEE
  OUVERTE
  COMPLETE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum InscriptionStatut {
  EN_ATTENTE
  VALIDEE
  SUSPENDUE
  ANNULEE
}

enum PaiementStatut {
  EN_ATTENTE
  ACOMPTE
  PAYE
  REMBOURSE
  ANNULE
}

enum CertificationResultat {
  NON_EVALUE
  CERTIFIE
  AJOURNE
  ABANDON
}

enum SeanceType {
  JOURNEE
  MATIN
  APRES_MIDI
}

enum PresenceStatut {
  PRESENT
  ABSENT
  RETARD
  EXCUSE
}

enum DemiJournee {
  MATIN
  APRES_MIDI
}

enum EvaluationType {
  POSITIONNEMENT
  ACQUIS
  SATISFACTION_CHAUD
  SATISFACTION_FROID
  BILAN
}

enum DocumentType {
  FICHE_INSCRIPTION
  CONTRAT_FORMATION
  CONVENTION_FORMATION
  CONVOCATION
  CONVOCATION_EXAMEN
  PROGRAMME
  ATTESTATION_ENTREE
  ATTESTATION_FIN
  ATTESTATION_REUSSITE
  CERTIFICAT_REALISATION
  QUESTIONNAIRE_POSITIONNEMENT
  QUESTIONNAIRE_SATISFACTION
  EVALUATION_CHAUD
  EVALUATION_FROID
  BILAN_INDIVIDUEL
  RELEVE_PRESENCE
  COMPTE_RENDU_PEDAGOGIQUE
  DOCUMENT_CPF
  DOCUMENT_OPCO
  AUTRE
}

enum SignatureProvider {
  YOUSIGN
  UNIVERSIGN
  DOCUSIGN
  INTERNE
}

enum SignatureStatut {
  EN_ATTENTE
  ENVOYEE
  SIGNEE
  REFUSEE
  EXPIREE
}

enum CrmStage {
  NOUVEAU
  QUALIFIE
  PROPOSITION
  NEGOCIATION
  GAGNE
  PERDU
}

enum InteractionType {
  APPEL
  EMAIL
  RDV
  NOTE
}

enum FactureStatut {
  BROUILLON
  ENVOYEE
  PAYEE
  PARTIELLE
  ANNULEE
  AVOIR
}

enum QualiopiStatut {
  CONFORME
  NON_CONFORME
  EN_COURS
  NON_APPLICABLE
}

enum AuditType {
  INTERNE
  EXTERNE
  SURVEILLANCE
}

enum WorkflowTrigger {
  AVANT_SESSION
  DEBUT_SESSION
  PENDANT_SESSION
  FIN_SESSION
  APRES_SESSION
}

enum WorkflowAction {
  ENVOI_CONVOCATION
  RAPPEL
  ENVOI_EMARGEMENT
  ENVOI_ATTESTATION
  ENVOI_CERTIFICAT
  ENVOI_QUESTIONNAIRE_SATISFACTION
  EMAIL_PERSONNALISE
}

enum EmailStatut {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

enum DataRequestType {
  EXPORT
  SUPPRESSION
}

enum DataRequestStatut {
  RECUE
  EN_COURS
  TRAITEE
  REFUSEE
}

// =============================================================
//  UTILISATEURS & AUTH (Auth.js — credentials + JWT)
// =============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ASSISTANT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profils liés (selon le rôle)
  formateur Formateur?
  apprenant Apprenant?

  // Traçabilité
  auditLogs          AuditLog[]
  documentsGeneres   DocumentGenere[]   @relation("DocumentGenerePar")
  piecesUploadees    PieceJointe[]      @relation("PieceUploadeePar")
  candidatsCrees     Candidat[]         @relation("CandidatCreePar")
  candidatsAssignes  Candidat[]         @relation("CandidatAssigne")
  candidatInteractions CandidatInteraction[] @relation("CandidatInteractionUser")
  sessionsCreees     Session[]          @relation("SessionCreeePar")
  interactionsCrm    CrmInteraction[]
  qualiopiResponsable QualiopiIndicateur[] @relation("IndicateurResponsable")
  dataRequestsTraitees DataRequest[]    @relation("DataRequestTraitePar")

  @@index([role])
}

// =============================================================
//  MODULE 1 — CANDIDATS
// =============================================================

model Candidat {
  id String @id @default(cuid())

  // Informations personnelles
  nom           String
  prenom        String
  dateNaissance DateTime?
  lieuNaissance String?
  paysNaissance String?
  telephone     String?
  email         String
  adresse       String?
  ville         String?
  codePostal    String?
  pays          String? @default("France")

  // Informations professionnelles
  situationPro   String?
  employeur      String?
  posteOccupe    String?
  dernierDiplome String? // dernier diplôme obtenu (niveau + intitulé)

  // Acquisition : comment le prospect nous a connus (TikTok, Facebook, Google, CPF…)
  sourceConnaissance String?

  // Financement envisagé
  financementType FinancementType?
  entrepriseId    String?
  entreprise      Entreprise? @relation(fields: [entrepriseId], references: [id])

  // Formation souhaitée (au stade prospect) — permet de classer les prospects par formation
  formationSouhaiteeId String?
  formationSouhaitee   Formation? @relation("FormationProspects", fields: [formationSouhaiteeId], references: [id])

  statut CandidatStatut @default(NOUVEAU)

  // ── CRM commercial (pipeline, opportunité, affectation, relance, tags) ──
  crmStage      CrmStage  @default(NOUVEAU) // étape du pipeline commercial
  tags          String[]  // étiquettes de segmentation
  valeurEstimee Decimal?  @db.Decimal(10, 2) // valeur estimée de l'opportunité
  relanceDate   DateTime? // prochaine relance commerciale
  assignedToId  String?
  assignedTo    User?     @relation("CandidatAssigne", fields: [assignedToId], references: [id])

  interactionsCandidat CandidatInteraction[]

  // ── Formulaire prospect public (lien envoyé par e-mail → fiche renseignée + signée) ──
  prospectToken          String?   @unique
  prospectFormSentAt     DateTime? // lien du formulaire prospect envoyé
  prospectFormCompletedAt DateTime? // prospect a rempli & signé sa fiche
  prospectSignatureUrl   String?   @db.Text // signature manuscrite (dessinée) du prospect
  prospectSignatureIp    String?

  // Relations
  apprenant    Apprenant?
  inscriptions Inscription[]
  pieces       PieceJointe[]
  consentements Consentement[]

  createdById String?
  createdBy   User?    @relation("CandidatCreePar", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([statut])
  @@index([email])
  @@index([crmStage])
  @@index([assignedToId])
}

// Interaction commerciale avec un prospect/candidat (timeline des échanges)
model CandidatInteraction {
  id         String          @id @default(cuid())
  candidatId String
  candidat   Candidat        @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  type       InteractionType
  date       DateTime        @default(now())
  sujet      String?
  contenu    String?         @db.Text
  userId     String?
  user       User?           @relation("CandidatInteractionUser", fields: [userId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([candidatId])
}

model PieceJointe {
  id        String   @id @default(cuid())
  candidatId String
  candidat  Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  label     String
  categorie String? // CV, CNI, DIPLOME, ADMINISTRATIF...
  url       String
  mimeType  String?
  taille    Int?
  uploadedById String?
  uploadedBy   User?  @relation("PieceUploadeePar", fields: [uploadedById], references: [id])
  createdAt DateTime @default(now())

  @@index([candidatId])
}

// =============================================================
//  MODULE 2 — CATALOGUE DE FORMATIONS (avec versions)
// =============================================================

model Formation {
  id                  String   @id @default(cuid())
  titre               String
  reference           String   @unique
  objectifs           String?  @db.Text
  programme           String?  @db.Text
  duree               String? // ex. "21h (14h distanciel + 7h présentiel)"
  dureeHeures         Int?
  tarif               Decimal? @db.Decimal(10, 2)
  modalite            Modalite @default(MIXTE)
  academy             Academy?
  prerequis           String?  @db.Text
  publicVise          String?  @db.Text
  methodesPedagogiques String? @db.Text
  modalitesEvaluation String?  @db.Text
  certification       String? // ex. RS6452

  // Accès & dossier administratif (V2)
  conditionsAcces String?  @db.Text // conditions d'accès / modalités d'inscription
  delaiAcces      String? // ex. "Inscription jusqu'à 48h avant le démarrage"
  piecesAttendues String[] // pièces du dossier administratif attendues (ex. CNI, CV…)

  // Versionnage / archivage
  version    Int     @default(1)
  isArchived Boolean @default(false)
  parentId   String? // formation source en cas de duplication/nouvelle version
  parent     Formation?  @relation("FormationVersions", fields: [parentId], references: [id])
  versions   Formation[] @relation("FormationVersions")

  sessions    Session[]
  evaluations Evaluation[]
  formateurs  Formateur[]
  prospects   Candidat[]   @relation("FormationProspects")
  cours       Cours[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isArchived])
}

// =============================================================
//  MODULE 3 — SESSIONS
// =============================================================

model Session {
  id          String        @id @default(cuid())
  formationId String
  formation   Formation     @relation(fields: [formationId], references: [id])
  reference   String?       @unique
  dateDebut   DateTime
  dateFin     DateTime
  horaires    String? // ex. "9h-12h30 / 13h30-17h"
  lieu        String?
  modalite    Modalite      @default(MIXTE)
  nbPlaces    Int           @default(10)
  statut      SessionStatut @default(PLANIFIEE)
  isArchived  Boolean       @default(false)

  // Tarif journalier du formateur pour cette session (sinon celui du formateur)
  tarifFormateurJour Decimal? @db.Decimal(10, 2)

  // Contrat de sous-traitance formateur (envoi → signature → PDF dans la session)
  contratFormateurToken        String?   @unique
  contratFormateurSentAt       DateTime?
  contratFormateurSignedAt     DateTime?
  contratFormateurSignatureUrl String?   @db.Text

  // Compte-rendu pédagogique formateur (formulaire post-session → document)
  crFormateurToken       String?   @unique
  crFormateurSentAt      DateTime?
  crFormateurJson        Json?
  crFormateurCompletedAt DateTime?

  formateurs   Formateur[]   @relation("SessionFormateurs")
  inscriptions Inscription[]
  seances      Seance[]
  evaluations  Evaluation[]
  documents    DocumentGenere[]
  conventions  Convention[]
  emailLogs    EmailLog[]
  emargementSignatures EmargementSignature[]

  createdById String?
  createdBy   User?    @relation("SessionCreeePar", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([statut])
  @@index([dateDebut])
}

model Formateur {
  id               String  @id @default(cuid())
  userId           String? @unique
  user             User?   @relation(fields: [userId], references: [id])
  nom              String
  prenom           String
  email            String?
  telephone        String?
  specialites      String?
  bio              String? @db.Text
  cvUrl            String?
  experienceAnnees Int?
  academies        Academy[]
  // Données contrat de sous-traitance
  adresse          String?
  siret            String?
  tarifJournalier  Decimal? @db.Decimal(10, 2)

  sessions   Session[]   @relation("SessionFormateurs")
  seances    Seance[]
  formations Formation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================
//  MODULE 4 — INSCRIPTIONS (formulaire public) & APPRENANTS
// =============================================================

model Apprenant {
  id         String   @id @default(cuid())
  candidatId String   @unique
  candidat   Candidat @relation(fields: [candidatId], references: [id])
  userId     String?  @unique // accès à l'espace apprenant
  user       User?    @relation(fields: [userId], references: [id])

  inscriptions       Inscription[]
  presences          Presence[]
  resultats          EvaluationResultat[]
  documents          DocumentGenere[]
  progressions       ProgressionLecon[]
  quizResultats      QuizResultat[]
  coursAssignes      CoursApprenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inscription {
  id          String   @id @default(cuid())
  candidatId  String
  candidat    Candidat @relation(fields: [candidatId], references: [id])
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  apprenantId String?
  apprenant   Apprenant? @relation(fields: [apprenantId], references: [id])
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  financementType FinancementType?
  statut          InscriptionStatut @default(EN_ATTENTE)
  montant         Decimal?          @db.Decimal(10, 2)

  // Paiement (mode + état du règlement)
  modePaiement   String?         // CPF, OPCO, France Travail, Virement, CB, Chèque, Espèces, Autre
  paiementStatut PaiementStatut  @default(EN_ATTENTE)

  // Résultat de certification (alimente le BPF)
  resultatCertification CertificationResultat @default(NON_EVALUE)
  certificationDate     DateTime?

  // Convocation à l'examen (e-mail séparé avec PDF)
  convocationExamenSentAt DateTime?

  // Suivi du dossier administratif (V2) — pièces marquées « reçues »
  // (la liste attendue provient de Formation.piecesAttendues)
  piecesRecues String[]

  // ── Parcours automatisé V2 (lien public + jalons) ──
  accessToken         String?   @unique // lien unique candidat (formulaire + signature)
  formCompletedAt     DateTime? // le candidat a rempli son formulaire
  signedAt            DateTime? // documents signés électroniquement (interne)
  signatureIp         String?
  signatureDataUrl    String?   @db.Text // image PNG de la signature manuscrite (dessinée)
  docsCopieSentAt     DateTime? // copie des docs signés envoyée au candidat
  convocationSentAt   DateTime? // convocation envoyée
  attestationEntreeSentAt DateTime? // attestation d'entrée envoyée (J1)
  satisfactionToken   String?   @unique // lien enquête de satisfaction
  satisfactionSentAt  DateTime? // enquête de satisfaction envoyée (fin)
  satisfactionJson    Json? // réponses à l'enquête
  satisfactionCompletedAt DateTime?
  docsFinSentAt       DateTime? // documents de fin de formation envoyés

  // RGPD & signature (formulaire public)
  consentementRgpd Boolean   @default(false)
  consentementDate DateTime?
  signatureStatut  SignatureStatut @default(EN_ATTENTE)
  source           String? // "formulaire_public", "manuel"...

  documents  DocumentGenere[]
  contrat    Contrat?
  convention Convention?
  factures   Facture[]
  signatures SignatureRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidatId, sessionId])
  @@index([statut])
}

// =============================================================
//  MODULE 5 — DOCUMENTS (modèles + génération + historisation)
// =============================================================

model DocumentTemplate {
  id        String       @id @default(cuid())
  nom       String
  type      DocumentType
  fileUrl   String? // modèle Word/PDF source
  contenu   String?      @db.Text // contenu HTML avec variables {{...}}
  variables String[] // liste des variables détectées
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  documents DocumentGenere[]
}

model DocumentGenere {
  id         String       @id @default(cuid())
  type       DocumentType
  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id])

  // Cibles possibles
  inscriptionId String?
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id])
  sessionId     String?
  session       Session?     @relation(fields: [sessionId], references: [id])
  apprenantId   String?
  apprenant     Apprenant?   @relation(fields: [apprenantId], references: [id])

  fileUrl       String?
  variablesJson Json?
  version       Int          @default(1)

  generatedById String?
  generatedBy   User?    @relation("DocumentGenerePar", fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())

  signatures SignatureRequest[]

  @@index([type])
  @@index([inscriptionId])
}

// =============================================================
//  MODULE 6 & 7 — ÉMARGEMENT, SÉANCES, SUIVI PÉDAGOGIQUE
// =============================================================

model Seance {
  id        String     @id @default(cuid())
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date      DateTime
  type      SeanceType @default(JOURNEE)
  heureDebut String?
  heureFin   String?

  formateurId String?
  formateur   Formateur? @relation(fields: [formateurId], references: [id])
  formateurSignatureUrl String?

  presences Presence[]

  @@index([sessionId])
}

model Presence {
  id          String         @id @default(cuid())
  seanceId    String
  seance      Seance         @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  apprenantId String
  apprenant   Apprenant      @relation(fields: [apprenantId], references: [id])
  statut      PresenceStatut @default(PRESENT)
  signatureUrl String?
  signedAt    DateTime?
  commentaire String?

  @@unique([seanceId, apprenantId])
}

// Signature d'émargement par demi-journée (lien e-mail → signature électronique)
model EmargementSignature {
  id          String      @id @default(cuid())
  sessionId   String
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date        DateTime
  demi        DemiJournee
  role        String      // "STAGIAIRE" | "FORMATEUR"
  nom         String
  email       String
  candidatId  String?
  token       String      @unique
  sentAt      DateTime?
  signedAt    DateTime?
  signatureIp String?
  signatureDataUrl String? @db.Text
  createdAt   DateTime    @default(now())

  @@index([sessionId])
}

// Réglages des automatismes (ligne unique « singleton »)
model AutomationSettings {
  id                      String   @id @default("singleton")
  convocationActive       Boolean  @default(true)
  convocationJMoins       Int      @default(7)
  attestationEntreeActive Boolean  @default(true)
  satisfactionActive      Boolean  @default(true)
  docsFinActive           Boolean  @default(true)
  compteRenduActive       Boolean  @default(true)
  emargementActive        Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

// =============================================================
//  MODULE 7 (suite) — ÉVALUATIONS & SATISFACTION
// =============================================================

model Evaluation {
  id           String         @id @default(cuid())
  titre        String
  type         EvaluationType
  formationId  String?
  formation    Formation?     @relation(fields: [formationId], references: [id])
  sessionId    String?
  session      Session?       @relation(fields: [sessionId], references: [id])
  questionsJson Json? // structure des questions
  createdAt    DateTime       @default(now())

  resultats EvaluationResultat[]
}

model EvaluationResultat {
  id           String     @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  apprenantId  String
  apprenant    Apprenant  @relation(fields: [apprenantId], references: [id])
  reponsesJson Json?
  score        Float?
  note         Float?
  commentaire  String?    @db.Text
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([evaluationId, apprenantId])
}

// =============================================================
//  CONVENTIONS & CONTRATS
// =============================================================

model Convention {
  id            String   @id @default(cuid())
  reference     String   @unique
  inscriptionId String?  @unique
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id])
  sessionId     String?
  session       Session? @relation(fields: [sessionId], references: [id])
  entrepriseId  String?
  entreprise    Entreprise? @relation(fields: [entrepriseId], references: [id])
  montant       Decimal? @db.Decimal(10, 2)
  dateSignature DateTime?
  signatureStatut SignatureStatut @default(EN_ATTENTE)
  fileUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Contrat {
  id            String   @id @default(cuid())
  reference     String   @unique
  inscriptionId String   @unique
  inscription   Inscription @relation(fields: [inscriptionId], references: [id])
  montant       Decimal? @db.Decimal(10, 2)
  dateSignature DateTime?
  signatureStatut SignatureStatut @default(EN_ATTENTE)
  fileUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =============================================================
//  MODULE 10 — QUALIOPI
// =============================================================

model QualiopiIndicateur {
  id            String         @id @default(cuid())
  numero        Int // 1 à 32 (RNQ)
  libelle       String
  description   String?        @db.Text
  statut        QualiopiStatut @default(EN_COURS)
  responsableId String?
  responsable   User?          @relation("IndicateurResponsable", fields: [responsableId], references: [id])
  commentaire   String?        @db.Text
  dateMaj       DateTime       @default(now())

  preuves QualiopiPreuve[]

  @@unique([numero])
}

model QualiopiPreuve {
  id           String   @id @default(cuid())
  indicateurId String
  indicateur   QualiopiIndicateur @relation(fields: [indicateurId], references: [id], onDelete: Cascade)
  label        String
  fileUrl      String?
  dateAjout    DateTime @default(now())

  @@index([indicateurId])
}

model Audit {
  id               String    @id @default(cuid())
  type             AuditType
  date             DateTime
  auditeur         String?
  organismeAudit   String?
  conformiteGlobale QualiopiStatut @default(EN_COURS)
  rapportUrl       String?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
}

// =============================================================
//  MODULE 12 — CRM ENTREPRISES
// =============================================================

model Entreprise {
  id            String   @id @default(cuid())
  raisonSociale String
  siret         String?
  adresse       String?
  ville         String?
  codePostal    String?
  contactNom    String?
  contactEmail  String?
  contactTel    String?
  stage         CrmStage @default(NOUVEAU)
  notes         String?  @db.Text

  candidats    Candidat[]
  inscriptions Inscription[]
  conventions  Convention[]
  interactions CrmInteraction[]
  devis        Devis[]
  factures     Facture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
}

model CrmInteraction {
  id           String          @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise      @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  type         InteractionType
  date         DateTime        @default(now())
  sujet        String?
  contenu      String?         @db.Text
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])

  @@index([entrepriseId])
}

// =============================================================
//  MODULE 16 — FACTURATION
// =============================================================

model Devis {
  id           String   @id @default(cuid())
  reference    String   @unique
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
  dateEmission DateTime @default(now())
  validUntil   DateTime?
  montantHT    Decimal  @default(0) @db.Decimal(10, 2)
  tva          Decimal  @default(20) @db.Decimal(5, 2)
  montantTTC   Decimal  @default(0) @db.Decimal(10, 2)
  lignesJson   Json?
  statut       FactureStatut @default(BROUILLON)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Facture {
  id            String        @id @default(cuid())
  reference     String        @unique
  entrepriseId  String?
  entreprise    Entreprise?   @relation(fields: [entrepriseId], references: [id])
  inscriptionId String?
  inscription   Inscription?  @relation(fields: [inscriptionId], references: [id])
  dateEmission  DateTime      @default(now())
  montantHT     Decimal       @default(0) @db.Decimal(10, 2)
  tva           Decimal       @default(20) @db.Decimal(5, 2)
  montantTTC    Decimal       @default(0) @db.Decimal(10, 2)
  lignesJson    Json?
  statut        FactureStatut @default(BROUILLON)
  datePaiement  DateTime?
  financementType FinancementType?
  avoirParentId String? // si c'est un avoir, référence la facture d'origine
  avoirParent   Facture?  @relation("FactureAvoirs", fields: [avoirParentId], references: [id])
  avoirs        Facture[] @relation("FactureAvoirs")

  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

model Paiement {
  id        String   @id @default(cuid())
  factureId String
  facture   Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant   Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  mode      String? // VIREMENT, CB, CPF, OPCO...
  reference String?

  @@index([factureId])
}

// =============================================================
//  MODULE 13 — AUTOMATISATIONS / WORKFLOWS & EMAILS
// =============================================================

model WorkflowRule {
  id         String          @id @default(cuid())
  nom        String
  trigger    WorkflowTrigger
  offsetDays Int             @default(0) // J-X / J+X
  action     WorkflowAction
  templateId String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  emailLogs EmailLog[]
}

model EmailLog {
  id             String      @id @default(cuid())
  destinataire   String
  sujet          String
  corps          String?     @db.Text
  statut         EmailStatut @default(EN_ATTENTE)
  sentAt         DateTime?
  sessionId      String?
  session        Session?    @relation(fields: [sessionId], references: [id])
  workflowRuleId String?
  workflowRule   WorkflowRule? @relation(fields: [workflowRuleId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([statut])
}

// =============================================================
//  MODULE 15 — SIGNATURE ÉLECTRONIQUE
// =============================================================

model SignatureRequest {
  id               String            @id @default(cuid())
  provider         SignatureProvider @default(INTERNE)
  documentGenereId String?
  documentGenere   DocumentGenere?   @relation(fields: [documentGenereId], references: [id])
  inscriptionId    String?
  inscription      Inscription?      @relation(fields: [inscriptionId], references: [id])
  statut           SignatureStatut   @default(EN_ATTENTE)
  signataires      Json? // [{nom,email,role}]
  externalId       String?
  signedFileUrl    String?
  createdAt        DateTime          @default(now())
  signedAt         DateTime?

  @@index([statut])
}

// =============================================================
//  MODULE 14 — RGPD
// =============================================================

model Consentement {
  id         String   @id @default(cuid())
  candidatId String?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])
  type       String // "traitement_donnees", "communications"...
  accepte    Boolean  @default(true)
  version    String?
  ip         String?
  accepteLe  DateTime @default(now())
  retireLe   DateTime?

  @@index([candidatId])
}

model DataRequest {
  id           String            @id @default(cuid())
  subjectEmail String
  type         DataRequestType
  statut       DataRequestStatut @default(RECUE)
  requestedAt  DateTime          @default(now())
  processedAt  DateTime?
  processedById String?
  processedBy   User?            @relation("DataRequestTraitePar", fields: [processedById], references: [id])
  notes        String?           @db.Text
}

// =============================================================
//  TRAÇABILITÉ — JOURNAL D'ACTIONS (historique complet)
// =============================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // CREATE / UPDATE / DELETE / LOGIN / GENERATE_DOC...
  entityType String // "Candidat", "Session"...
  entityId   String?
  changesJson Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// =============================================================
//  MODULE E-LEARNING (LMS) — cours par academy/formation
//  Cours → Modules → Leçons (texte + vidéo + ressources + quiz)
//  Accès réservé aux apprenants inscrits à la formation du cours.
// =============================================================

model Cours {
  id          String   @id @default(cuid())
  titre       String
  slug        String   @unique
  description String?  @db.Text
  academy     Academy
  formationId String?
  formation   Formation? @relation(fields: [formationId], references: [id])
  niveau      String? // ex. « Débutant », « B1 »…
  imageUrl    String?
  isPublished Boolean  @default(false)
  ordre       Int      @default(0)

  modules    CoursModule[]
  apprenants CoursApprenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academy])
  @@index([formationId])
}

model CoursModule {
  id      String  @id @default(cuid())
  coursId String
  cours   Cours   @relation(fields: [coursId], references: [id], onDelete: Cascade)
  titre   String
  ordre   Int     @default(0)

  lecons Lecon[]

  @@index([coursId])
}

model Lecon {
  id          String  @id @default(cuid())
  moduleId    String
  module      CoursModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titre       String
  ordre       Int     @default(0)
  contenu     String? @db.Text // texte riche (HTML)
  videoUrl    String? // lien YouTube / Vimeo
  imagesJson  Json? // [{ url, legende }]
  dureeMin    Int?
  ressourcesJson Json? // [{ label, url }]
  quizJson    Json? // [{ type: QCU|QCM|REDIGEE, enonce, options[], bonnes[], corrige }]
  isPublished Boolean @default(true)

  progressions  ProgressionLecon[]
  quizResultats QuizResultat[]

  @@index([moduleId])
}

// Suivi de progression : une ligne = une leçon terminée par un apprenant
model ProgressionLecon {
  id          String    @id @default(cuid())
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  leconId     String
  lecon       Lecon     @relation(fields: [leconId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())

  @@unique([apprenantId, leconId])
  @@index([apprenantId])
}

// Résultat de quiz d'une leçon pour un apprenant
model QuizResultat {
  id          String    @id @default(cuid())
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  leconId     String
  lecon       Lecon     @relation(fields: [leconId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  completedAt DateTime  @default(now())

  @@unique([apprenantId, leconId])
  @@index([apprenantId])
}

// Attribution d'un cours à un apprenant (accès e-learning géré par l'admin)
model CoursApprenant {
  id          String    @id @default(cuid())
  coursId     String
  cours       Cours     @relation(fields: [coursId], references: [id], onDelete: Cascade)
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([coursId, apprenantId])
  @@index([apprenantId])
  @@index([coursId])
}

// ───── Registres Qualiopi (critère 6 & 7) ─────

enum ReclamationOrigine {
  STAGIAIRE
  FORMATEUR
  ENTREPRISE
  FINANCEUR
  AUTRE
}

enum ReclamationStatut {
  NOUVELLE
  ACCUSE_RECEPTION // AR envoyé (sous 5 jours ouvrés)
  EN_TRAITEMENT
  CLOTUREE
}

// Registre des réclamations / aléas (indicateurs 31-32)
model Reclamation {
  id          String             @id @default(cuid())
  date        DateTime           @default(now())
  origine     ReclamationOrigine @default(STAGIAIRE)
  declarant   String // nom du réclamant
  contact     String? // email / téléphone
  formation   String? // formation ou session concernée
  objet       String
  description String             @db.Text
  gravite     Int                @default(1) // 1 mineure · 2 modérée · 3 majeure
  statut      ReclamationStatut  @default(NOUVELLE)
  arDate      DateTime? // date de l'accusé de réception (objectif : 5 j ouvrés)
  analyse     String?            @db.Text // causes identifiées
  actions     String?            @db.Text // actions correctives / préventives
  reponseDate DateTime? // date de la réponse argumentée (objectif : 15 j ouvrés)
  clotureDate DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([statut])
}

enum VeilleType {
  LEGALE // indicateur 23 — légale et réglementaire
  METIERS // indicateur 24 — compétences, métiers, emplois
  PEDAGOGIQUE // indicateur 25 — innovations pédagogiques et technologiques
}

// Registre de veille (indicateurs 23-24-25)
model VeilleEntree {
  id        String     @id @default(cuid())
  type      VeilleType
  date      DateTime   @default(now())
  source    String // ex. Légifrance, Centre Inffo, INRS…
  sujet     String
  resume    String?    @db.Text
  action    String?    @db.Text // mise en œuvre dans l'organisme
  lien      String?
  createdAt DateTime   @default(now())

  @@index([type])
}

// Registre des partenaires (indicateurs 26-27 : handicap + réseau socio-économique)
model Partenaire {
  id        String   @id @default(cuid())
  nom       String
  categorie String // ex. Handicap, Emploi, Entreprise, Institutionnel
  contact   String?
  telephone String?
  email     String?
  objet     String?  @db.Text // nature du partenariat / services
  createdAt DateTime @default(now())
}
