// =============================================================
//  UTILISATEURS & AUTH (Auth.js — credentials + JWT)
// =============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // Mot de passe temporaire à changer à la première connexion (compte candidat
  // créé automatiquement à l'inscription). Redirige vers /bienvenue tant que true.
  mustChangePassword Boolean @default(false)
  name         String
  role         Role     @default(ASSISTANT)
  /// Intitulé de poste dans l'OF (secrétaire, comptable, référent handicap…),
  /// purement descriptif : le niveau de permission réel reste porté par `role`.
  fonction     String?
  isActive     Boolean  @default(true)
  // Tenant : organisme de rattachement. NULL pour le SUPERADMIN (éditeur).
  organismeId  String?
  organisme    Organisme? @relation(fields: [organismeId], references: [id])
  // Sections autorisées pour un collaborateur (clés de lib/permissions).
  // Ignoré pour ADMIN (accès total). Vide = aucun accès aux sections.
  permissions  String[] @default([])
  // Centre de notifications : date de dernière consultation (badge « non lus »).
  notificationsSeenAt DateTime?
  // Session unique : identifiant de la dernière connexion active. Toute connexion
  // sur un autre appareil le remplace → l'ancien appareil est déconnecté
  // (empêche le partage d'un compte = facturation par siège respectée).
  activeSessionId String?
  // Double authentification (TOTP) — secret chiffré au repos (lib/crypto).
  // Optionnelle : tant que totpEnabled = false, la connexion est inchangée.
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  inviteToken       String?   @unique
  inviteTokenExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Profils liés (selon le rôle)
  formateur Formateur?
  entreprise        Entreprise? @relation("EntrepriseCompte")
  apprenant Apprenant?

  // Traçabilité
  auditLogs          AuditLog[]
  paiementsEnregistres Paiement[]       @relation("PaiementEnregistrePar")
  documentsGeneres   DocumentGenere[]   @relation("DocumentGenerePar")
  piecesUploadees    PieceJointe[]      @relation("PieceUploadeePar")
  candidatsCrees     Candidat[]         @relation("CandidatCreePar")
  candidatsAssignes  Candidat[]         @relation("CandidatAssigne")
  candidatInteractions CandidatInteraction[] @relation("CandidatInteractionUser")
  sessionsCreees     Session[]          @relation("SessionCreeePar")
  interactionsCrm    CrmInteraction[]
  qualiopiResponsable QualiopiIndicateur[] @relation("IndicateurResponsable")
  dataRequestsTraitees DataRequest[]    @relation("DataRequestTraitePar")
  // Notifications push (app mobile) : jetons des appareils de l'utilisateur.
  deviceTokens         DeviceToken[]

  @@index([role])
}

// Jeton d'appareil pour les notifications push de l'app mobile (Capacitor).
// Un utilisateur peut avoir plusieurs appareils ; `token` = registration token
// FCM (Android) / APNs (iOS). Alimenté par /api/push/register depuis l'app.
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// =============================================================
//  MODULE 1 — CANDIDATS
// =============================================================

enum Genre {
  HOMME
  FEMME
}

model Candidat {
  id String @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  deletedAt DateTime? // corbeille soft-delete (audit A09-003) — filtré par scopedPrisma

  // Informations personnelles
  nom           String
  prenom        String
  genre         Genre? // état civil (Homme/Femme) — nullable : renseigné à la saisie, pas rétro-actif
  dateNaissance DateTime?
  lieuNaissance String? // commune de naissance
  departementNaissance String? // code département (ou "99" pour l'étranger)
  paysNaissance String?
  telephone     String?
  email         String
  adresse       String?
  ville         String?
  codePostal    String?
  pays          String? @default("France")

  // Informations professionnelles
  situationPro   String?
  employeur      String?
  posteOccupe    String?
  dernierDiplome String? // dernier diplôme obtenu (niveau + intitulé)
  photoUrl       String? @db.Text // photo d'identité (data URL compressée, fournie à l'inscription)

  // Acquisition : comment le prospect nous a connus (TikTok, Facebook, Google, CPF…)
  sourceConnaissance String?

  // Financement envisagé
  financementType FinancementType?
  entrepriseId    String?
  entreprise      Entreprise? @relation(fields: [entrepriseId], references: [id])

  // Formation souhaitée (au stade prospect) — permet de classer les prospects par formation
  formationSouhaiteeId String?
  formationSouhaitee   Formation? @relation("FormationProspects", fields: [formationSouhaiteeId], references: [id])

  statut CandidatStatut @default(NOUVEAU)

  // ── CRM commercial (pipeline, opportunité, affectation, relance, tags) ──
  crmStage      CrmStage  @default(NOUVEAU) // étape du pipeline commercial
  tags          String[]  // étiquettes de segmentation
  valeurEstimee Decimal?  @db.Decimal(10, 2) // valeur estimée de l'opportunité
  relanceDate   DateTime? // prochaine relance commerciale
  assignedToId  String?
  assignedTo    User?     @relation("CandidatAssigne", fields: [assignedToId], references: [id])

  // ── Sécurité privée : prérequis réglementaires (TFP APS, MAC APS) ──
  cnapsStatut        CnapsStatut? // suivi de l'autorisation préalable CNAPS
  cnapsNumero        String?      // n° de l'autorisation préalable CNAPS (TFP APS initial)
  cnapsValiditeDate  DateTime?    // date d'expiration de l'autorisation CNAPS (valable 6 mois)
  carteProNumero     String?      // n° de carte professionnelle (si déjà titulaire)
  carteProValidite   DateTime?    // date de fin de validité de la carte pro

  // ── Sécurité incendie : diplôme SSIAP détenu (recyclage / remise à niveau) ──
  ssiapNiveau         Int?      // niveau du diplôme SSIAP détenu (1, 2 ou 3)
  ssiapDiplomeNumero  String?   // n° du diplôme SSIAP (figure sur l'attestation de recyclage)
  ssiapDiplomeDate    DateTime? // date d'obtention du diplôme SSIAP

  // ── Transport (VTC / Taxi) : prérequis réglementaires ──
  carteProVtcTaxiNumero      String?   // n° carte pro VTC/taxi (prérequis formation continue)
  carteProVtcTaxiValidite    DateTime? // date de fin de validité de la carte pro VTC/taxi
  examenTheoriqueVtcTaxiDate DateTime? // date de réussite de l'examen théorique VTC/taxi (passerelle, valable < 3 ans)

  // ── Accessibilité (Qualiopi ind. 26) + RGPD ──
  situationHandicap Boolean   @default(false) // situation de handicap déclarée
  besoinsAdaptation String?   @db.Text // adaptations pédagogiques nécessaires
  anonymiseLe       DateTime? // horodatage de l'anonymisation RGPD (purge / effacement)

  // ── Expression de besoin (analyse du besoin — Qualiopi ind. 4), renseignée à l'inscription ──
  nationalite        String?
  objectifsFormation String? @db.Text // motif : reconversion, obligation réglementaire, évolution…
  periodeSouhaitee   String? // période souhaitée (dates précises / hors vacances / sans préférence)
  sessionSouhaitee   String? // session choisie (date + lieu, issue du planning)

  interactionsCandidat CandidatInteraction[]
  messagesPortail      CandidatMessage[]

  // ── Formulaire prospect public (lien envoyé par e-mail → fiche renseignée + signée) ──
  prospectToken          String?   @unique
  prospectFormSentAt     DateTime? // lien du formulaire prospect envoyé
  prospectFormCompletedAt DateTime? // prospect a rempli & signé sa fiche
  prospectSignatureUrl   String?   @db.Text // signature manuscrite (dessinée) du prospect
  prospectSignatureIp    String?

  // Relations
  apprenant    Apprenant?
  inscriptions Inscription[]
  pieces       PieceJointe[]
  consentements Consentement[]
  conversations Conversation[]
  dossiersFinancement DossierFinancement[]
  parcoursT3P  ParcoursT3P[]

  // ── E-learning examen civique (préparation en ligne, site vitrine) ──
  // Le jeton est PROVISIONNÉ par la plateforme : c'est elle qui crée les
  // comptes candidats. Le vitrine s'authentifie avec (email + civicToken).
  civicToken       String?           @unique
  // Fin d'accès e-learning (compte désactivé après cette date — 30 j par défaut).
  civicAccessUntil DateTime?
  // Statut administratif du compte e-learning (créé/géré depuis le back-office).
  civicAccessStatut CivicAccessStatut @default(ACTIF)
  // Mentions (formations) auxquelles le compte donne accès — alimenté à la
  // création manuelle et à chaque paiement (en ligne ou physique).
  civicMentions    CivicMention[]    @default([])
  civicAssessments CivicAssessment[]
  civicProgress    CivicProgress[]
  civicWeaknesses  CivicWeakness[]
  civicMockExams   CivicMockExam[]
  civicPaiements   CivicPaiement[]
  civicFactures    CivicFacture[]

  createdById String?
  createdBy   User?    @relation("CandidatCreePar", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([statut])
  @@index([email])
  @@index([crmStage])
  @@index([assignedToId])
  @@index([organismeId])
}

// Interaction commerciale avec un prospect/candidat (timeline des échanges)
model CandidatInteraction {
  id         String          @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  candidatId String
  candidat   Candidat        @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  type       InteractionType
  date       DateTime        @default(now())
  sujet      String?
  contenu    String?         @db.Text
  userId     String?
  user       User?           @relation("CandidatInteractionUser", fields: [userId], references: [id])
  createdAt  DateTime        @default(now())

  @@index([candidatId])
  @@index([organismeId])
}

model PieceJointe {
  id        String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  candidatId String
  candidat  Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  label     String
  categorie String? // CV, CNI, DIPLOME, ADMINISTRATIF...
  url       String
  mimeType  String?
  taille    Int?
  // Validation par l'OF (dossier administratif)
  statut     PieceStatut @default(EN_ATTENTE)
  motifRefus String?
  uploadedById String?
  uploadedBy   User?  @relation("PieceUploadeePar", fields: [uploadedById], references: [id])
  createdAt DateTime @default(now())

  @@index([candidatId])
  @@index([organismeId])
}

// =============================================================
//  MODULE 2 — CATALOGUE DE FORMATIONS (avec versions)
// =============================================================

model Formation {
  id                  String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  titre               String
  reference           String // unique PAR organisme (cf. @@unique plus bas)
  objectifs           String?  @db.Text
  programme           String?  @db.Text
  duree               String? // ex. "21h (14h distanciel + 7h présentiel)"
  dureeHeures         Int?
  dureeJours          Int? // durée en jours (fait foi pour le calcul du contrat, sans les week-ends)
  tarif               Decimal? @db.Decimal(10, 2)
  modalite            Modalite @default(MIXTE)
  academy             Academy?
  // Publication sur le site vitrine (piloté depuis la console).
  vitrineStatut       VitrineStatut @default(MASQUEE)
  // Numéro d'agrément de la formation (saisi manuellement ; affiché sur le vitrine).
  numeroAgrement      String?
  // Contenu de présentation pour le site vitrine (formations créées EN console).
  vitrineTagline      String?
  vitrineDescription  String?  @db.Text
  vitrineImageUrl     String?  @db.Text
  vitrineCompetences  String[] @default([])
  vitrineValidite     String?
  vitrineModalites    String?  @db.Text
  // Formules (formats) proposées sur le site vitrine, avec heures + prix par
  // formule. JSON : [{ key, label, heures, prix, description }]. Piloté depuis
  // la console (repli sur les valeurs statiques du vitrine si absent).
  vitrineFormules     Json?
  prerequis           String?  @db.Text
  publicVise          String?  @db.Text
  methodesPedagogiques String? @db.Text
  modalitesEvaluation String?  @db.Text
  positionnementQuestions Json? // ~10 questions QCU/QCM/courtes (lien envoyé le 1er jour à 9h)
  certification       String? // ex. RS6452

  // Accès & dossier administratif (V2)
  conditionsAcces String?  @db.Text // conditions d'accès / modalités d'inscription
  delaiAcces      String? // ex. "Inscription jusqu'à 48h avant le démarrage"
  piecesAttendues String[] // pièces du dossier administratif attendues (ex. CNI, CV…)

  // La formation est sanctionnée par un examen → convocation d'examen pertinente
  // (sinon : pas de convocation d'examen, ex. SST / MAC SST / MAC APS).
  examen Boolean @default(false)
  // Formation diplômante (titre/diplôme) → active le suivi de diplômes.
  diplomante Boolean @default(false)
  // Examen soumis à un jury → active la gestion de jury + nb de jurés attendus.
  soumisJury Boolean @default(false)
  nbJury     Int?
  // Grille de certification officielle INRS à pré-remplir (doc réglementaire) :
  // "SST" ou "MAC_SST" (cf. public/inrs/). Vide = pas de grille INRS.
  grilleInrs String?

  // Versionnage / archivage
  version    Int     @default(1)
  isArchived Boolean @default(false)
  parentId   String? // formation source en cas de duplication/nouvelle version
  parent     Formation?  @relation("FormationVersions", fields: [parentId], references: [id])
  versions   Formation[] @relation("FormationVersions")

  sessions    Session[]
  evaluations Evaluation[]
  formateurs  Formateur[]
  prospects   Candidat[]   @relation("FormationProspects")
  cours       Cours[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organismeId, reference])
  @@index([isArchived])
  @@index([organismeId])
}

// =============================================================
//  MODULE 3 — SESSIONS
// =============================================================

model Session {
  id          String        @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  deletedAt   DateTime? // corbeille soft-delete (audit A09-003) — distinct de archivedAt (clôture Qualiopi)
  formationId String
  formation   Formation     @relation(fields: [formationId], references: [id])
  reference   String? // unique PAR organisme (cf. @@unique plus bas)
  dateDebut   DateTime
  dateFin     DateTime
  horaires    String? // ex. "9h-12h30 / 13h30-17h"
  lieu        String?
  // Examen (formations soumises à examen, ex. TFP APS) : date + lieu dédiés.
  dateExamen  DateTime?
  lieuExamen  String? // adresse de l'examen (OF ou autre centre d'examen)
  // Phase 3 — certification : date à laquelle les résultats ont été déclarés
  // au certificateur (suivi de la transmission des résultats d'examen).
  resultatsDeclaresAt DateTime?
  modalite    Modalite      @default(MIXTE)
  nbPlaces    Int           @default(10)
  statut      SessionStatut @default(PLANIFIEE)
  isArchived  Boolean       @default(false)
  archivedAt  DateTime? // clôture/archivage (validation Qualiopi complète)
  archivedBy  String? // collaborateur ayant archivé
  // Marques de validation manuelle (doc session/formateur confirmé sur place).
  // Clé = itemKey de la config de validation → { nom, userId, date, comment }.
  validationJson Json?

  // Salle (gestion des salles / planning)
  salleId     String?
  salle       Salle?        @relation(fields: [salleId], references: [id])

  // Tarif journalier du formateur pour cette session (sinon celui du formateur)
  tarifFormateurJour Decimal? @db.Decimal(10, 2)
  // Animation par formateur : [{ formateurId, complet, jours: ["AAAA-MM-JJ"] }].
  // complet = toute la session ; sinon les jours couverts. Base du nombre de jours
  // du contrat de sous-traitance + de la facturation (formateurs EXTERNES).
  formateursAnimation Json?

  // Contrat de sous-traitance formateur (envoi → signature → PDF dans la session)
  contratFormateurToken        String?   @unique
  contratFormateurSentAt       DateTime?
  contratFormateurSignedAt     DateTime?
  contratFormateurSignatureUrl String?   @db.Text

  // Compte-rendu pédagogique formateur (formulaire post-session → document)
  crFormateurToken       String?   @unique
  crFormateurSentAt      DateTime?
  crFormateurJson        Json?
  crFormateurCompletedAt DateTime?

  formateurs   Formateur[]   @relation("SessionFormateurs")
  inscriptions Inscription[]
  seances      Seance[]
  socialAssets SocialContentAsset[]
  evaluations  Evaluation[]
  documents    DocumentGenere[]
  conventions  Convention[]
  demandesInscription DemandeInscription[] @relation("DemandeSession")
  demandesProposees   DemandeInscription[] @relation("DemandeSessionProposee")
  emailLogs    EmailLog[]
  emargementSignatures EmargementSignature[]
  facturesFormateur FactureFormateur[]
  juryAffectations JuryAffectation[]

  createdById String?
  createdBy   User?    @relation("SessionCreeePar", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organismeId, reference])
  @@index([statut])
  @@index([dateDebut])
  @@index([organismeId])
}

// Salle de formation (gestion des salles + planning). Cloisonnée par organisme.
model Salle {
  id          String  @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  nom         String
  capacite    Int?
  lieu        String? // adresse / bâtiment / étage
  equipements String? // ex. "Vidéoprojecteur, tableau, 12 postes"
  couleur     String? @default("#1A5FD4") // pastille planning
  actif       Boolean @default(true)
  notes       String? @db.Text

  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organismeId])
}

enum FormateurType {
  INTERNE // salarié de l'école — pas de contrat de sous-traitance
  EXTERNE // intervenant externe — contrat + tarif journalier
}

model Formateur {
  id               String  @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  userId           String? @unique
  user             User?   @relation(fields: [userId], references: [id])
  nom              String
  prenom           String
  email            String?
  telephone        String?
  specialites      String?
  bio              String? @db.Text
  cvUrl            String?
  experienceAnnees Int?
  academies        Academy[]
  // Données contrat de sous-traitance
  adresse          String?
  siret            String?
  tarifJournalier  Decimal? @db.Decimal(10, 2)
  /// Interne (salarié, pas de contrat) ou externe (sous-traitant à contractualiser).
  typeContrat      FormateurType @default(EXTERNE)

  sessions   Session[]   @relation("SessionFormateurs")
  seances    Seance[]
  formations Formation[]
  factures   FactureFormateur[]
  disponibilites Disponibilite[]
  conversations  Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organismeId])
}

// =============================================================
//  MODULE 4 — INSCRIPTIONS (formulaire public) & APPRENANTS
// =============================================================

model Apprenant {
  id         String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  candidatId String   @unique
  candidat   Candidat @relation(fields: [candidatId], references: [id])
  userId     String?  @unique // accès à l'espace apprenant
  user       User?    @relation(fields: [userId], references: [id])

  inscriptions       Inscription[]
  presences          Presence[]
  resultats          EvaluationResultat[]
  documents          DocumentGenere[]
  progressions       ProgressionLecon[]
  quizResultats      QuizResultat[]
  coursAssignes      CoursApprenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organismeId])
}

model Inscription {
  id          String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  deletedAt   DateTime? // corbeille soft-delete (audit A09-003) — filtré par scopedPrisma
  candidatId  String
  candidat    Candidat @relation(fields: [candidatId], references: [id])
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id])
  apprenantId String?
  apprenant   Apprenant? @relation(fields: [apprenantId], references: [id])
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])

  financementType FinancementType?
  statut          InscriptionStatut @default(EN_ATTENTE)
  montant         Decimal?          @db.Decimal(10, 2)

  // Paiement (mode + état du règlement)
  modePaiement   String?         // CPF, OPCO, France Travail, Virement, CB, Chèque, Espèces, Autre
  paiementStatut PaiementStatut  @default(EN_ATTENTE)

  // Résultat de certification (alimente le BPF)
  resultatCertification CertificationResultat @default(NON_EVALUE)
  certificationDate     DateTime?

  // Convocation à l'examen (e-mail séparé avec PDF)
  convocationExamenSentAt DateTime?

  // Suivi du dossier administratif (V2) — pièces marquées « reçues »
  // (la liste attendue provient de Formation.piecesAttendues)
  piecesRecues String[]
  // Traçabilité : pour chaque pièce validée, qui l'a validée et quand.
  // Forme : { "<piece>": { "nom": "<collaborateur>", "date": "<ISO>" } }
  piecesValideePar Json?
  // Collaborateur ayant validé la signature « sur place » (traçabilité).
  signedParNom String?
  // Validation « signé sur place » document par document (traçabilité).
  // Forme : { "<docType>": { "nom": "<collaborateur>", "date": "<ISO>" } }
  docsSignes Json?

  // ── Parcours automatisé V2 (lien public + jalons) ──
  accessToken         String?   @unique // lien unique candidat (formulaire + signature)
  formCompletedAt     DateTime? // le candidat a rempli son formulaire
  docsLusAt           DateTime? // le candidat a consulté les documents contractuels
  signedAt            DateTime? // documents signés électroniquement (interne)
  signatureIp         String?
  signatureDataUrl    String?   @db.Text // image PNG de la signature manuscrite (dessinée)
  docsCopieSentAt     DateTime? // copie des docs signés envoyée au candidat
  convocationSentAt   DateTime? // convocation envoyée
  rappelSentAt        DateTime? // e-mail de rappel J-1 envoyé (24h avant le début)
  attestationReussiteSentAt DateTime? // attestation de réussite envoyée (après « certifié »)
  attestationEntreeSentAt DateTime? // attestation d'entrée envoyée (J1)
  satisfactionToken   String?   @unique // lien enquête de satisfaction
  satisfactionSentAt  DateTime? // enquête de satisfaction envoyée (fin)
  satisfactionJson    Json? // réponses à l'enquête
  satisfactionCompletedAt DateTime?
  positionnementToken       String?   @unique // lien test de positionnement (J1 9h)
  positionnementSentAt      DateTime?
  positionnementJson        Json? // réponses du candidat
  positionnementCompletedAt DateTime?
  positionnementSignature   String?   @db.Text // signature manuscrite (PNG data URL)
  francaisToken       String?   @unique // lien test de français (J1)
  francaisSentAt      DateTime?
  francaisJson        Json? // réponses au test de français
  francaisCompletedAt DateTime?
  francaisSignature   String?   @db.Text // signature manuscrite (PNG data URL)
  satisfactionEntrepriseToken       String?   @unique // lien enquête satisfaction côté entreprise (B2B)
  satisfactionEntrepriseSentAt      DateTime?
  satisfactionEntrepriseJson        Json? // réponses de l'entreprise (+ __signature)
  satisfactionEntrepriseCompletedAt DateTime?
  docsFinSentAt       DateTime? // documents de fin de formation envoyés

  // ── Enquête de suivi à 6 mois (Qualiopi ind. 11 — devenir/insertion pro) ──
  // Token indexé (non @unique) pour éviter une contrainte bloquante en prod ;
  // généré aléatoirement (24 octets) → collision négligeable. Lecture via findFirst.
  suivi6moisToken       String? // lien public de l'enquête à 6 mois
  suivi6moisSentAt      DateTime? // enquête 6 mois envoyée
  suivi6moisJson        Json? // réponses (situation pro, lien formation, etc.)
  suivi6moisCompletedAt DateTime?
  suivi6moisSignature   String?   @db.Text // signature manuscrite (PNG data URL)

  // RGPD & signature (formulaire public)
  consentementRgpd Boolean   @default(false)
  consentementDate DateTime?
  signatureStatut  SignatureStatut @default(EN_ATTENTE)
  source           String? // "formulaire_public", "manuel"...

  documents  DocumentGenere[]
  contrat    Contrat?
  convention Convention? @relation("ConventionUnique")
  // Convention de GROUPE (client pro) : plusieurs salariés sous une même convention.
  conventionId     String?
  conventionGroupe Convention? @relation("ConventionGroupe", fields: [conventionId], references: [id])
  factures   Facture[]
  paiements  Paiement[]
  dossiersFinancement DossierFinancement[]
  signatures SignatureRequest[]
  parcoursT3P ParcoursT3P?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cache du dossier PDF complet (perf). Régénéré si l'inscription change
  // (dossierPdfVersion dérivée de updatedAt + version de gabarit) ; sinon servi
  // depuis la base (évite un démarrage Chromium à chaque ouverture). RGPD : reste
  // dans le tenant, derrière l'authentification.
  dossierPdf        Bytes?
  dossierPdfVersion String?
  dossierPdfName    String?

  @@unique([candidatId, sessionId])
  @@index([statut])
  @@index([organismeId])
  @@index([suivi6moisToken])
  // Audit 07 (A07-007) : FK chaude (contrôle de places + participants par session)
  @@index([sessionId, statut])
  @@index([entrepriseId])
  @@index([apprenantId])
}

// =============================================================
//  MODULE 5 — DOCUMENTS (modèles + génération + historisation)
// =============================================================

model DocumentTemplate {
  id        String       @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  nom       String
  type      DocumentType
  fileUrl   String? // modèle Word/PDF source
  contenu   String?      @db.Text // contenu HTML avec variables {{...}}
  variables String[] // liste des variables détectées
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  documents DocumentGenere[]
  @@index([organismeId])
}

model DocumentGenere {
  id         String       @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  type       DocumentType
  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id])

  // Cibles possibles
  inscriptionId String?
  // Document généré = pièce régénérable → suit l'inscription (cascade). Les données
  // comptables (Facture/Convention/Contrat) restent en Restrict (cf. DB-05).
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       Session?     @relation(fields: [sessionId], references: [id])
  apprenantId   String?
  apprenant     Apprenant?   @relation(fields: [apprenantId], references: [id])

  fileUrl       String?
  variablesJson Json?
  version       Int          @default(1)

  generatedById String?
  generatedBy   User?    @relation("DocumentGenerePar", fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())

  signatures SignatureRequest[]

  @@index([type])
  @@index([inscriptionId])
  @@index([organismeId])
  // Audit 07 (A07-007) : tri createdAt desc scopé tenant (historique documentaire)
  @@index([organismeId, createdAt])
}

// =============================================================
//  MODULE 6 & 7 — ÉMARGEMENT, SÉANCES, SUIVI PÉDAGOGIQUE
// =============================================================

model Seance {
  id        String     @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  sessionId String
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date      DateTime
  type      SeanceType @default(JOURNEE)
  heureDebut String?
  heureFin   String?

  formateurId String?
  formateur   Formateur? @relation(fields: [formateurId], references: [id])
  formateurSignatureUrl String?

  presences Presence[]

  @@index([sessionId])
  @@index([organismeId])
}

model Presence {
  id          String         @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  seanceId    String
  seance      Seance         @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  apprenantId String
  apprenant   Apprenant      @relation(fields: [apprenantId], references: [id])
  statut      PresenceStatut @default(PRESENT)
  signatureUrl String?
  signedAt    DateTime?
  commentaire String?

  @@unique([seanceId, apprenantId])
  @@index([organismeId])
}

// Signature d'émargement par demi-journée (lien e-mail → signature électronique)
model EmargementSignature {
  id          String      @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  sessionId   String
  session     Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date        DateTime
  demi        DemiJournee
  role        String      // "STAGIAIRE" | "FORMATEUR"
  nom         String
  email       String
  candidatId  String?
  token       String      @unique
  sentAt      DateTime?
  signedAt    DateTime?
  signatureIp String?
  signatureDataUrl String? @db.Text
  createdAt   DateTime    @default(now())

  @@index([sessionId])
  @@index([organismeId])
}

// Réglages des automatismes (ligne unique « singleton »)
model AutomationSettings {
  id                      String   @id @default(cuid())
  organismeId String? @unique // tenant (multi-OF) — 1 ligne de réglages par organisme
  convocationActive       Boolean  @default(true)
  convocationJMoins       Int      @default(7)
  attestationEntreeActive Boolean  @default(true)
  satisfactionActive      Boolean  @default(true)
  docsFinActive           Boolean  @default(true)
  compteRenduActive       Boolean  @default(true)
  emargementActive        Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

// =============================================================
//  MODULE 7 (suite) — ÉVALUATIONS & SATISFACTION
// =============================================================

model Evaluation {
  id           String         @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  titre        String
  type         EvaluationType
  formationId  String?
  formation    Formation?     @relation(fields: [formationId], references: [id])
  sessionId    String?
  session      Session?       @relation(fields: [sessionId], references: [id])
  questionsJson Json? // structure des questions
  createdAt    DateTime       @default(now())

  resultats EvaluationResultat[]
  @@index([organismeId])
}

model EvaluationResultat {
  id           String     @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  apprenantId  String
  apprenant    Apprenant  @relation(fields: [apprenantId], references: [id])
  reponsesJson Json?
  score        Float?
  note         Float?
  commentaire  String?    @db.Text
  completedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@unique([evaluationId, apprenantId])
  @@index([organismeId])
}

// =============================================================
//  CONVENTIONS & CONTRATS
// =============================================================

model Convention {
  id            String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  reference     String // unique PAR organisme (cf. @@unique)
  inscriptionId String?  @unique
  inscription   Inscription? @relation("ConventionUnique", fields: [inscriptionId], references: [id])
  // Convention de GROUPE (client pro) : plusieurs salariés rattachés.
  inscriptions  Inscription[] @relation("ConventionGroupe")
  sessionId     String?

  @@unique([organismeId, reference])
  session       Session? @relation(fields: [sessionId], references: [id])
  entrepriseId  String?
  entreprise    Entreprise? @relation(fields: [entrepriseId], references: [id])
  montant       Decimal? @db.Decimal(10, 2)
  dateSignature DateTime?
  signatureStatut SignatureStatut @default(EN_ATTENTE)
  fileUrl       String? // PDF de la convention GÉNÉRÉE (non signée) par l'OF
  fileUrlSigne  String? // PDF SIGNÉ, déposé par le client B2B ou par l'OF (reçu par mail)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([organismeId])
}

model Contrat {
  id            String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  reference     String // unique PAR organisme (cf. @@unique)
  inscriptionId String   @unique
  inscription   Inscription @relation(fields: [inscriptionId], references: [id])

  @@unique([organismeId, reference])
  montant       Decimal? @db.Decimal(10, 2)
  dateSignature DateTime?
  signatureStatut SignatureStatut @default(EN_ATTENTE)
  fileUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([organismeId])
}

// =============================================================
//  MODULE 10 — QUALIOPI
// =============================================================

model QualiopiIndicateur {
  id            String         @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  numero        Int // 1 à 32 (RNQ)
  libelle       String
  description   String?        @db.Text
  statut        QualiopiStatut @default(EN_COURS)
  responsableId String?
  responsable   User?          @relation("IndicateurResponsable", fields: [responsableId], references: [id])
  commentaire   String?        @db.Text
  dateMaj       DateTime       @default(now())

  preuves QualiopiPreuve[]

  // Indicateurs propres à CHAQUE organisme (multi-tenant) : l'unicité est par
  // (organisme, numéro), pas globale, sinon un seul OF pourrait suivre ses 32.
  @@unique([organismeId, numero])
  @@index([organismeId])
}

model QualiopiPreuve {
  id           String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  indicateurId String
  indicateur   QualiopiIndicateur @relation(fields: [indicateurId], references: [id], onDelete: Cascade)
  label        String
  fileUrl      String?
  dateAjout    DateTime @default(now())

  @@index([indicateurId])
  @@index([organismeId])
}

model Audit {
  id               String    @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  type             AuditType
  date             DateTime
  auditeur         String?
  organismeAudit   String?
  conformiteGlobale QualiopiStatut @default(EN_COURS)
  rapportUrl       String?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  @@index([organismeId])
}

// =============================================================
//  MODULE 12 — CRM ENTREPRISES
// =============================================================

model Entreprise {
  id            String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  deletedAt   DateTime? // corbeille soft-delete (audit A09-003) — filtré par scopedPrisma
  raisonSociale String
  siret         String?
  adresse       String?
  ville         String?
  codePostal    String?
  contactNom    String?
  contactEmail  String?
  contactTel    String?
  representant  String? // signataire légal (nom + prénom)
  fonction      String? // fonction du signataire
  numeroTva     String? // n° TVA intracommunautaire
  opco          String? // financeur habituel (AKTO, autre OPCO, autofinancement…)
  stage         CrmStage @default(NOUVEAU)
  notes         String?  @db.Text
  // Espace client (portail self-service B2B) : lien tokenisé en lecture seule.
  // Jeton aléatoire (24 octets) → recherche par findFirst ; pas de contrainte
  // unique (évite une migration destructive sur la base partagée).
  portalToken   String?
  userId String? @unique
  user   User?   @relation("EntrepriseCompte", fields: [userId], references: [id])

  candidats    Candidat[]
  inscriptions Inscription[]
  conventions  Convention[]
  interactions CrmInteraction[]
  devis        Devis[]
  factures     Facture[]
  demandesInscription DemandeInscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([organismeId])
  @@index([portalToken])
}

/// Demande d'inscription self-service émise par un client B2B (rôle ENTREPRISE)
/// depuis son espace : le client choisit des salariés pour une session, l'OF
/// valide (→ createConventionEntreprise) ou propose d'autres dates / refuse.
model DemandeInscription {
  id           String     @id @default(cuid())
  organismeId  String? // tenant (multi-OF)
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  sessionId    String
  session      Session    @relation("DemandeSession", fields: [sessionId], references: [id])
  // Salariés demandés : [{ candidatId } | { nom, prenom, email }]
  salariesJson Json
  // Mode de financement précisé par le client (OPCO, autofinancement…).
  financementType FinancementType?
  statut       DemandeInscriptionStatut @default(EN_ATTENTE)
  // Contre-proposition de l'OF : autre session suggérée.
  sessionProposeeId String?
  sessionProposee   Session? @relation("DemandeSessionProposee", fields: [sessionProposeeId], references: [id])
  motif        String? // motif de refus / note OF
  traiteeParId String? // collaborateur ayant traité
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([organismeId])
  @@index([entrepriseId])
  @@index([statut])
}

enum DemandeInscriptionStatut {
  EN_ATTENTE
  CONTRE_PROPOSEE
  CONFIRMEE
  REFUSEE
  ANNULEE
}

model CrmInteraction {
  id           String          @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  entrepriseId String
  entreprise   Entreprise      @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  type         InteractionType
  date         DateTime        @default(now())
  sujet        String?
  contenu      String?         @db.Text
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])

  @@index([entrepriseId])
  @@index([organismeId])
}

// =============================================================
//  MODULE 16 — FACTURATION
// =============================================================

model Devis {
  id           String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  reference    String
  // Destinataire : entreprise cliente OU client libre (particulier)
  entrepriseId String?
  entreprise   Entreprise? @relation(fields: [entrepriseId], references: [id])
  clientNom    String?
  clientEmail  String?
  objet        String?
  dateEmission DateTime @default(now())
  validUntil   DateTime?
  montantHT    Decimal  @default(0) @db.Decimal(10, 2)
  tva          Decimal  @default(20) @db.Decimal(5, 2)
  montantTTC   Decimal  @default(0) @db.Decimal(10, 2)
  lignesJson   Json?
  statut       FactureStatut @default(BROUILLON)
  // Acceptation/signature en ligne du devis (bon pour accord)
  acceptToken  String?  @unique
  acceptedAt   DateTime?
  signataire   String?
  signatureUrl String?  @db.Text
  signatureIp  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([organismeId, reference])
  @@index([organismeId])
}

// Tâche / rappel (agenda commercial). Cloisonnée par organisme.
model Tache {
  id          String    @id @default(cuid())
  organismeId String?
  titre       String
  description String?   @db.Text
  dueDate     DateTime?
  done        Boolean   @default(false)
  candidatId  String? // lien optionnel vers un prospect/candidat (id, sans relation)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organismeId])
  @@index([done])
}

// SMS sortant (module avancé « SMS & séquences »). Envoi via Brevo SMS si une
// clé est configurée pour l'OF, sinon journalisé en mode démo.
model SmsLog {
  id          String   @id @default(cuid())
  organismeId String?
  destinataire String  // numéro au format international (+33…)
  body        String   @db.Text
  candidatId  String? // lien optionnel vers un prospect/candidat
  statut      String   @default("EN_ATTENTE") // EN_ATTENTE / ENVOYE / ECHEC / DEMO
  providerId  String? // id renvoyé par le fournisseur (Brevo)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([organismeId])
}

model Facture {
  id            String        @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  deletedAt   DateTime? // corbeille soft-delete (audit A09-003) — filtré par scopedPrisma
  reference     String // unique PAR organisme (cf. @@unique)
  entrepriseId  String?
  entreprise    Entreprise?   @relation(fields: [entrepriseId], references: [id])
  inscriptionId String?

  @@unique([organismeId, reference])
  inscription   Inscription?  @relation(fields: [inscriptionId], references: [id])
  dateEmission  DateTime      @default(now())
  montantHT     Decimal       @default(0) @db.Decimal(10, 2)
  tva           Decimal       @default(20) @db.Decimal(5, 2)
  montantTTC    Decimal       @default(0) @db.Decimal(10, 2)
  lignesJson    Json?
  fileUrl       String? // PDF déposé par l'admin (fait sur un autre logiciel) → téléchargé par le client B2B depuis son espace
  statut        FactureStatut @default(BROUILLON)
  datePaiement  DateTime?
  financementType FinancementType?
  avoirParentId String? // si c'est un avoir, référence la facture d'origine
  avoirParent   Facture?  @relation("FactureAvoirs", fields: [avoirParentId], references: [id])
  avoirs        Facture[] @relation("FactureAvoirs")

  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([organismeId])
}

model Paiement {
  id        String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  // Un règlement est rattaché à une facture OU directement à une inscription
  // (saisie « Enregistrer un règlement » depuis le suivi comptable).
  factureId String?
  facture   Facture?  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  inscriptionId String?
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  montant   Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  mode      String? // VIREMENT, CB, CPF, OPCO...
  reference String?
  // Traçabilité : collaborateur ayant saisi le règlement
  enregistreParId String?
  enregistrePar   User?   @relation("PaiementEnregistrePar", fields: [enregistreParId], references: [id])

  createdAt DateTime @default(now())

  @@index([factureId])
  @@index([inscriptionId])
  @@index([enregistreParId])
  @@index([organismeId])
}

// Facture déposée par un formateur (sous-traitant) depuis son espace, avec suivi
// de paiement côté OF (en attente → en cours → payée).
model FactureFormateur {
  id          String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  formateurId String
  formateur   Formateur @relation(fields: [formateurId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     Session?  @relation(fields: [sessionId], references: [id])

  reference   String?
  montant     Decimal  @db.Decimal(10, 2)
  fichierUrl  String?  @db.Text // PDF/justificatif déposé par le formateur
  commentaire String?  @db.Text
  statut      FactureFormateurStatut @default(EN_ATTENTE)
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organismeId])
  @@index([formateurId])
  @@index([statut])
}

// Disponibilité déclarée par un formateur (planification des sessions par l'OF).
model Disponibilite {
  id          String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  formateurId String
  formateur   Formateur @relation(fields: [formateurId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  demi        DemiJournee? // null = journée entière
  dispo       Boolean   @default(true) // true = disponible, false = indisponible
  note        String?
  createdAt   DateTime  @default(now())

  @@index([organismeId])
  @@index([formateurId])
  @@index([date])
}

// Fil de discussion OF ↔ candidat ou OF ↔ formateur (messagerie légère).
model Conversation {
  id          String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  sujet       String?
  candidatId  String?
  candidat    Candidat?  @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  formateurId String?
  formateur   Formateur? @relation(fields: [formateurId], references: [id], onDelete: Cascade)

  messages    Message[]
  lastMessageAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([organismeId])
  @@index([candidatId])
  @@index([formateurId])
}

model Message {
  id             String       @id @default(cuid())
  organismeId    String? // tenant (multi-OF)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteur         MessageAuteur
  auteurUserId   String?
  corps          String       @db.Text
  luParOf        Boolean      @default(false) // lu côté organisme
  luParClient    Boolean      @default(false) // lu côté candidat/formateur
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([organismeId])
}

// =============================================================
//  MODULE 13 — AUTOMATISATIONS / WORKFLOWS & EMAILS
// =============================================================

model WorkflowRule {
  id         String          @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  nom        String
  trigger    WorkflowTrigger
  offsetDays Int             @default(0) // J-X / J+X
  action     WorkflowAction
  templateId String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  emailLogs EmailLog[]
  @@index([organismeId])
}

model EmailLog {
  id             String      @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  destinataire   String
  sujet          String
  corps          String?     @db.Text
  statut         EmailStatut @default(EN_ATTENTE)
  sentAt         DateTime?
  sessionId      String?
  session        Session?    @relation(fields: [sessionId], references: [id])
  workflowRuleId String?
  workflowRule   WorkflowRule? @relation(fields: [workflowRuleId], references: [id])
  createdAt      DateTime    @default(now())

  @@index([statut])
  @@index([organismeId])
  // Audit 07 (A07-007) : tri createdAt desc scopé tenant (journal e-mails)
  @@index([organismeId, createdAt])
}

// =============================================================
//  MODULE 15 — SIGNATURE ÉLECTRONIQUE
// =============================================================

model SignatureRequest {
  id               String            @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  provider         SignatureProvider @default(INTERNE)
  documentGenereId String?
  documentGenere   DocumentGenere?   @relation(fields: [documentGenereId], references: [id])
  inscriptionId    String?
  // Demande de signature = technique → suit l'inscription (cascade). Cf. DB-05.
  inscription      Inscription?      @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  statut           SignatureStatut   @default(EN_ATTENTE)
  signataires      Json? // [{nom,email,role}]
  externalId       String?
  signedFileUrl    String?
  createdAt        DateTime          @default(now())
  signedAt         DateTime?

  @@index([statut])
  @@index([organismeId])
}

// =============================================================
//  MODULE 14 — RGPD
// =============================================================

model Consentement {
  id         String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  candidatId String?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])
  type       String // "traitement_donnees", "communications"...
  accepte    Boolean  @default(true)
  version    String?
  ip         String?
  accepteLe  DateTime @default(now())
  retireLe   DateTime?

  @@index([candidatId])
  @@index([organismeId])
}

model DataRequest {
  id           String            @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  subjectEmail String
  type         DataRequestType
  statut       DataRequestStatut @default(RECUE)
  requestedAt  DateTime          @default(now())
  processedAt  DateTime?
  processedById String?
  processedBy   User?            @relation("DataRequestTraitePar", fields: [processedById], references: [id])
  notes        String?           @db.Text
  @@index([organismeId])
}

// =============================================================
//  TRAÇABILITÉ — JOURNAL D'ACTIONS (historique complet)
// =============================================================

model AuditLog {
  id         String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // CREATE / UPDATE / DELETE / LOGIN / GENERATE_DOC...
  entityType String // "Candidat", "Session"...
  entityId   String?
  changesJson Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([organismeId])
  // Audit 07 (A07-007) : tri createdAt desc (console cross-tenant + par tenant)
  @@index([organismeId, createdAt])
  @@index([createdAt])
}

// =============================================================
//  MODULE E-LEARNING (LMS) — cours par academy/formation
//  Cours → Modules → Leçons (texte + vidéo + ressources + quiz)
//  Accès réservé aux apprenants inscrits à la formation du cours.
// =============================================================

model Cours {
  id          String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  titre       String
  slug        String // unique PAR organisme (cf. @@unique)
  description String?  @db.Text
  academy     Academy

  @@unique([organismeId, slug])
  formationId String?
  formation   Formation? @relation(fields: [formationId], references: [id])
  niveau      String? // ex. « Débutant », « B1 »…
  imageUrl    String?
  isPublished Boolean  @default(false)
  ordre       Int      @default(0)

  modules    CoursModule[]
  apprenants CoursApprenant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academy])
  @@index([formationId])
  @@index([organismeId])
}

model CoursModule {
  id      String  @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  coursId String
  cours   Cours   @relation(fields: [coursId], references: [id], onDelete: Cascade)
  titre   String
  ordre   Int     @default(0)

  lecons Lecon[]

  @@index([coursId])
  @@index([organismeId])
}

model Lecon {
  id          String  @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  moduleId    String
  module      CoursModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  titre       String
  ordre       Int     @default(0)
  contenu     String? @db.Text // texte riche (HTML)
  videoUrl    String? // lien YouTube / Vimeo
  imagesJson  Json? // [{ url, legende }]
  dureeMin    Int?
  ressourcesJson Json? // [{ label, url }]
  quizJson    Json? // [{ type: QCU|QCM|REDIGEE, enonce, options[], bonnes[], corrige }]
  isPublished Boolean @default(true)

  progressions  ProgressionLecon[]
  quizResultats QuizResultat[]

  @@index([moduleId])
  @@index([organismeId])
}

// Suivi de progression : une ligne = une leçon terminée par un apprenant
model ProgressionLecon {
  id          String    @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  leconId     String
  lecon       Lecon     @relation(fields: [leconId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())

  @@unique([apprenantId, leconId])
  @@index([apprenantId])
  @@index([organismeId])
}

// Résultat de quiz d'une leçon pour un apprenant
model QuizResultat {
  id          String    @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  leconId     String
  lecon       Lecon     @relation(fields: [leconId], references: [id], onDelete: Cascade)
  score       Int
  total       Int
  completedAt DateTime  @default(now())

  @@unique([apprenantId, leconId])
  @@index([apprenantId])
  @@index([organismeId])
}

// Attribution d'un cours à un apprenant (accès e-learning géré par l'admin)
model CoursApprenant {
  id          String    @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  coursId     String
  cours       Cours     @relation(fields: [coursId], references: [id], onDelete: Cascade)
  apprenantId String
  apprenant   Apprenant @relation(fields: [apprenantId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([coursId, apprenantId])
  @@index([apprenantId])
  @@index([coursId])
  @@index([organismeId])
}

// ───── Registres Qualiopi (critère 6 & 7) ─────

enum ReclamationOrigine {
  STAGIAIRE
  FORMATEUR
  ENTREPRISE
  FINANCEUR
  AUTRE
}

enum ReclamationStatut {
  NOUVELLE
  ACCUSE_RECEPTION // AR envoyé (sous 5 jours ouvrés)
  EN_TRAITEMENT
  CLOTUREE
}

// Registre des réclamations / aléas (indicateurs 31-32)
model Reclamation {
  id          String             @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  date        DateTime           @default(now())
  origine     ReclamationOrigine @default(STAGIAIRE)
  declarant   String // nom du réclamant
  contact     String? // email / téléphone
  formation   String? // formation ou session concernée
  objet       String
  description String             @db.Text
  gravite     Int                @default(1) // 1 mineure · 2 modérée · 3 majeure
  statut      ReclamationStatut  @default(NOUVELLE)
  arDate      DateTime? // date de l'accusé de réception (objectif : 5 j ouvrés)
  analyse     String?            @db.Text // causes identifiées
  actions     String?            @db.Text // actions correctives / préventives
  reponseDate DateTime? // date de la réponse argumentée (objectif : 15 j ouvrés)
  clotureDate DateTime?
  signatureDataUrl String? @db.Text // signature du déclarant (formulaire en ligne)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([statut])
  @@index([organismeId])
}

enum VeilleType {
  LEGALE // indicateur 23 — légale et réglementaire
  METIERS // indicateur 24 — compétences, métiers, emplois
  PEDAGOGIQUE // indicateur 25 — innovations pédagogiques et technologiques
}

// Registre de veille (indicateurs 23-24-25)
model VeilleEntree {
  id        String     @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  type      VeilleType
  date      DateTime   @default(now())
  source    String // ex. Légifrance, Centre Inffo, INRS…
  sujet     String
  resume    String?    @db.Text
  action    String?    @db.Text // mise en œuvre dans l'organisme
  lien      String?
  createdAt DateTime   @default(now())

  @@index([type])
  @@index([organismeId])
}

// Registre des partenaires (indicateurs 26-27 : handicap + réseau socio-économique)
model Partenaire {
  id        String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  nom       String
  categorie String // ex. Handicap, Emploi, Entreprise, Institutionnel
  contact   String?
  telephone String?
  email     String?
  objet     String?  @db.Text // nature du partenariat / services
  createdAt DateTime @default(now())
  @@index([organismeId])
}

// =============================================================
//  SUPPORT TECHNIQUE — tickets entre un organisme client et l'éditeur
//  (le client ouvre/répond depuis sa plateforme ; l'éditeur traite
//   depuis la console SUPERADMIN /console/support).
// =============================================================
model SupportTicket {
  id          String          @id @default(cuid())
  organismeId String
  organisme   Organisme       @relation(fields: [organismeId], references: [id], onDelete: Cascade)
  sujet       String
  priorite    SupportPriorite @default(NORMALE)
  statut      SupportStatut   @default(OUVERT)
  demandeurNom   String?
  demandeurEmail String?
  // Suivi « non lu » de chaque côté (badges).
  nonLuSupport Boolean @default(true)  // un nouveau message client attend l'éditeur
  nonLuClient  Boolean @default(false) // une réponse éditeur attend le client

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organismeId])
  @@index([statut])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  corps     String        @db.Text
  parSupport Boolean      @default(false) // true = message de l'éditeur, false = du client
  auteurNom String?
  createdAt DateTime       @default(now())

  @@index([ticketId])
}

// =============================================================
//  LEADS COMMERCIAUX OFManager — prospects issus du site vitrine
//  (formulaire de contact / demande de démo). Niveau ÉDITEUR (pas
//  de tenant) : gérés depuis la console SUPERADMIN /console/prospects.
// =============================================================
enum LeadStatut {
  FICHIER
  CONTACTE
  ENGAGE
  QUALIFIE
  DEMO_PLANIFIEE
  DEMO_REALISEE
  PROPOSITION
  SIGNE
  PERDU
}

model Lead {
  id          String     @id @default(cuid())
  nom         String
  organisme   String?
  email       String
  telephone   String?
  message     String?    @db.Text
  source      String?    // "contact" | "demo"
  hebergement String?    // préférence d'hébergement (demande de démo)
  formations  String[]   @default([]) // formations concernées (demande de démo)
  statut      LeadStatut @default(FICHIER)
  notes       String?    @db.Text // notes internes de l'équipe OFManager
  rappeleAt   DateTime?  // date du 1er contact effectué
  lu          Boolean    @default(false) // consulté par l'éditeur (badge)
  // Démo auto-provisionnée pour ce prospect (tenant Organisme isDemo=true).
  demoOrganismeId String?
  // Score d'engagement (console growth) : recalculé à chaque LeadEvent.
  score       Int        @default(0)
  // Qualification commerciale (plan de lancement, feuille 6) — scoring 5 axes.
  verticale            String? // securite | transport | autre
  outilActuel          String? // aucun | excel | concurrent | inconnu
  echeanceQualiopi     String? // moins_6_mois | plus_6_mois | non_concerne | inconnu
  volumeStagiairesMois Int?
  malARemplir          Boolean? // « dit avoir du mal à remplir ses sessions »
  decideur             String? // décideur identifié (nom / fonction)
  // Prospection CRM sortante (fichiers Excel sécurité / transport) — cf. lib/growth/crm-prospect.ts.
  region             String? // région administrative (déduite du code postal) — découpage sécurité
  departement        String? // département — découpage transport
  codePostal         String?
  ville              String?
  adresse            String?
  siteWeb            String?
  siret              String?
  representantLegal  String? // dirigeant / gérant identifié
  priorite           String? // haute | moyenne | basse
  typeFormation      String? // Taxi | VTC | Taxi + VTC (transport)
  agrement           String? // N° agrément / validité préfectorale (transport)
  agrementEchu       Boolean? // agrément retiré / échu (nom en rouge dans le fichier)
  prochaineAction    String?
  dateRelance        DateTime?
  dateDernierContact DateTime?
  sourceRemarques    String?   @db.Text // colonne « Source / Remarques » (origine + réseaux / ⚠ doublons)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  events LeadEvent[]
  tasks  LeadTask[]

  @@index([statut])
  @@index([createdAt])
  @@index([siret])
  @@index([region])
  @@index([departement])
}

// Événement de la timeline d'un lead (console growth éditeur) : demande de démo,
// provisionnement, 1re connexion, prolongation, e-mail ouvert/cliqué, changement
// de statut, note… Alimente aussi le score d'engagement.
model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // cf. lib/growth/events.ts (LEAD_EVENT_TYPES)
  titre     String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// Tâche de relance commerciale attachée à un lead (à faire par l'éditeur).
model LeadTask {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  titre     String
  dueAt     DateTime?
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([leadId])
  @@index([done, dueAt])
}

// Tarif d'une formule, éditable par le SUPERADMIN depuis la console.
// Une ligne par formule ; en l'absence de ligne on retombe sur les valeurs par
// défaut de lib/plans.ts. La vitrine (/tarifs) et le tableau de bord (MRR)
// lisent ces valeurs. Modèle GLOBAL (hors cloisonnement multi-tenant).
model PlanTarif {
  id              String            @id @default(cuid())
  formule         FormuleAbonnement @unique
  nom             String? // nom commercial personnalisé (repli sur le défaut de plans.ts)
  prix            Int // € / mois (HT)
  tagline         String
  supportLevel    String
  comptesInclus   Int?              // comptes back-office inclus ; 0 = illimité ; null = défaut code
  fonctionnalites String[]          @default([]) // composition (clés) ; vide = bundle par défaut
  populaire       Boolean           @default(false) // badge « le plus choisi »
  updatedAt       DateTime          @updatedAt
}

// =============================================================
//  MODULE — E-LEARNING EXAMEN CIVIQUE (préparation en ligne)
//  Tables consommées par le site vitrine (adaptive learning).
//  Les comptes candidats sont créés par la plateforme (civicToken).
// =============================================================

enum CivicMention {
  CSP
  CR
  NATURALISATION
}

enum CivicPath {
  EXPERT
  STANDARD
  RENFORCE
  ACCOMPAGNEMENT
}

enum CivicModuleStatut {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// Statut administratif du compte e-learning d'un candidat.
///  ACTIF      = accès ouvert (dans la limite de civicAccessUntil)
///  SUSPENDU   = accès bloqué temporairement (impayé, litige…)
///  DESACTIVE  = accès clos (fin de prestation)
enum CivicAccessStatut {
  ACTIF
  SUSPENDU
  DESACTIVE
}

/// Positionnement (= candidate_assessment) : double score + parcours.
model CivicAssessment {
  id              String       @id @default(cuid())
  organismeId     String? // tenant (multi-OF)
  candidatId      String
  candidat        Candidat     @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  mention         CivicMention
  languageScore   Int // 0-100
  civicsScore     Int // 0-100
  langNiveau      String // A2-, A2, B1, B2
  recommendedPath CivicPath
  date            DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([candidatId, mention])
  @@index([organismeId])
}

/// Progression d'un module (= candidate_progress).
model CivicProgress {
  id             String            @id @default(cuid())
  organismeId    String? // tenant (multi-OF)
  candidatId     String
  candidat       Candidat          @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  moduleId       String // `${mention}:${theme}` ex. "csp:T1"
  startDate      DateTime          @default(now())
  endDate        DateTime?
  score          Int               @default(0) // dernier score %
  attempts       Int               @default(0)
  timeSpent      Int               @default(0) // secondes cumulées
  completionRate Int               @default(0) // 0-100
  statut         CivicModuleStatut @default(IN_PROGRESS)
  updatedAt      DateTime          @updatedAt

  @@unique([candidatId, moduleId])
  @@index([organismeId])
  @@index([candidatId])
}

/// Faiblesse par thème/sous-thème (= candidate_weakness).
model CivicWeakness {
  id           String   @id @default(cuid())
  organismeId  String? // tenant (multi-OF)
  candidatId   String
  candidat     Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  theme        String // T1..T5
  sousTheme    String
  errorCount   Int      @default(0)
  lastSeen     DateTime @default(now())
  masteryLevel Int      @default(0) // 0-100

  @@unique([candidatId, theme, sousTheme])
  @@index([organismeId])
  @@index([candidatId])
}

/// Examen blanc (= candidate_mock_exam).
model CivicMockExam {
  id                 String       @id @default(cuid())
  organismeId        String? // tenant (multi-OF)
  candidatId         String
  candidat           Candidat     @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  mention            CivicMention
  score              Int // %
  total              Int
  bonnes             Int
  successProbability Int // 0-100
  date               DateTime     @default(now())
  createdAt          DateTime     @default(now())

  @@index([organismeId])
  @@index([candidatId])
}

/// Tarif de la prépa civique en ligne — éditable par l'admin, par mention.
/// La remise (promo) s'applique au prix ; les codes promo Stripe restent
/// possibles en plus (allow_promotion_codes au Checkout).
model CivicTarif {
  id          String       @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  mention     CivicMention
  prixCents   Int // prix TTC en centimes (ex. 14900 = 149 €)
  devise      String       @default("eur")
  remisePct   Int          @default(0) // remise % (0-100)
  actif       Boolean      @default(true)
  updatedAt   DateTime     @updatedAt

  @@unique([organismeId, mention])
  @@index([organismeId])
}

/// Paiement d'une prépa civique en ligne (Stripe Checkout), SANS Inscription
/// (formation 100 % en ligne, en continu). Sert au suivi et à la compta.
/// Mode de règlement d'un paiement civique.
enum CivicPaiementMethode {
  STRIPE // carte bancaire en ligne (Stripe Checkout)
  CB_TPE // carte bancaire au terminal physique
  ESPECES // espèces
  CHEQUE // chèque
  VIREMENT // virement bancaire
}

model CivicPaiement {
  id              String               @id @default(cuid())
  organismeId     String? // tenant (multi-OF)
  candidatId      String
  candidat        Candidat             @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  mention         CivicMention
  montantCents    Int
  devise          String               @default("eur")
  methode         CivicPaiementMethode @default(STRIPE)
  /// Présent uniquement pour les paiements en ligne (Stripe). Null si physique.
  stripeSessionId String?              @unique
  statut          String               @default("paye") // paye | en_attente | rembourse | annule
  date            DateTime             @default(now())
  /// Utilisateur ayant encaissé un paiement physique (back-office).
  encaissePar     String?
  notes           String?
  /// Horodatage de l'envoi de l'e-mail (code d'accès + reçu) — garantit l'envoi unique.
  emailSentAt     DateTime?
  facture         CivicFacture?

  @@index([organismeId])
  @@index([candidatId])
}

/// Facture numérotée émise pour un paiement civique (en ligne ou physique).
/// Nature d'un document de facturation civique.
enum CivicFactureType {
  FACTURE
  AVOIR
}

/// TVA gérée (par défaut 0 % — formation exonérée art. 261-4-4° du CGI).
/// Un AVOIR (remboursement) porte des montants négatifs et référence la
/// facture d'origine via `factureOrigineId`.
model CivicFacture {
  id              String               @id @default(cuid())
  organismeId     String? // tenant (multi-OF)
  type            CivicFactureType     @default(FACTURE)
  numero          String // ex. CIV-2026-0001 (facture) ou AVOIR-2026-0001
  candidatId      String
  candidat        Candidat             @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  paiementId      String?              @unique
  paiement        CivicPaiement?       @relation(fields: [paiementId], references: [id], onDelete: SetNull)
  // Avoir → facture d'origine (auto-relation).
  factureOrigineId String?
  factureOrigine   CivicFacture?       @relation("CivicAvoir", fields: [factureOrigineId], references: [id])
  avoirs           CivicFacture[]      @relation("CivicAvoir")
  mention         CivicMention
  clientNom       String
  clientEmail     String?
  clientAdresse   String?
  montantHtCents  Int
  tvaPct          Int                  @default(0)
  tvaCents        Int                  @default(0)
  montantTtcCents Int
  methode         CivicPaiementMethode
  exonereTva      Boolean              @default(true)
  date            DateTime             @default(now())
  emisePar        String?
  createdAt       DateTime             @default(now())

  @@unique([organismeId, numero])
  @@index([organismeId])
  @@index([candidatId])
  @@index([factureOrigineId])
}

// =============================================================
//  SUIVI FINANCIER DU CENTRE — dépenses & charges (toutes activités)
//  Sert au bilan mensuel/annuel : balance CA (facturé) − dépenses.
// =============================================================

/// Catégorie de dépense/charge du centre de formation.
enum DepenseCategorie {
  LOYER
  ELECTRICITE
  TELEPHONIE
  FORMATEUR
  JURY_EXAMEN
  VISITE_SITE
  JURY_SSIAP
  DIPLOME
  ADS // campagnes publicitaires
  FOURNITURE_BUREAU
  FRAIS_EXAMEN_VTC
  FOURNITURE_ALIMENTAIRE
  CARBURANT
  AUTRE // libellé libre dans `categorieAutre`
}

/// État de règlement d'une dépense.
enum DepenseStatut {
  PAYE
  EN_ATTENTE
}

/// Une dépense/charge du centre (loyer, formateur, ADS, carburant…).
model DepenseCentre {
  id             String           @id @default(cuid())
  organismeId    String? // tenant (multi-OF)
  date           DateTime         @default(now()) // date de la dépense (mois de rattachement)
  categorie      DepenseCategorie
  categorieAutre String? // précision si categorie = AUTRE
  libelle        String? // description libre
  montantCents   Int
  devise         String           @default("eur")
  numeroPiece    String? // n° de facture ou de reçu
  statut         DepenseStatut    @default(PAYE)
  notes          String?
  createdById    String? // utilisateur ayant saisi la dépense
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organismeId])
  @@index([date])
}

// =============================================================
//  VALIDATIONS — délégation du droit de valider (maker-checker léger)
//  Un collaborateur ayant la section "validations" peut valider/refuser
//  des demandes ; le NOM du validateur est tracé (dénormalisé).
// =============================================================

enum ValidationType {
  DOSSIER // dossier / pièces d'un candidat
  INSCRIPTION // inscription à valider
  TACHE_CANDIDAT // tâche réalisée par le candidat (ou avec lui)
  PAIEMENT // paiement encaissé
  DEPENSE // dépense saisie
  AUTRE
}

enum ValidationStatut {
  EN_ATTENTE
  VALIDE
  REFUSE
}

/// Demande de validation soumise par un collaborateur, à valider par un autre.
model ValidationDemande {
  id          String           @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  type        ValidationType
  titre       String
  description String?
  lienHref    String? // lien vers l'objet concerné (fiche candidat, inscription…)
  candidatId  String?
  statut      ValidationStatut @default(EN_ATTENTE)
  createdById String? // demandeur
  createdByNom String? // demandeur (dénormalisé, affichage)
  valideParId String? // validateur
  valideParNom String? // NOM du collaborateur qui a validé (traçabilité)
  motifRefus  String?
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?

  @@index([organismeId])
  @@index([statut])
  @@index([candidatId])
}

/// Compteur séquentiel ATOMIQUE par organisme (numérotation factures/devis
/// anti-trou et anti-doublon). `cle` = ex. "DEV-2026", "CIV-2026", "AVOIR-2026".
/// L'incrément se fait via `update { valeur: { increment: 1 } }` (atomique DB) ;
/// la ligne est auto-amorcée depuis le max historique lors de sa 1re création.
model NumeroSequence {
  id          String   @id @default(cuid())
  organismeId String
  cle         String
  valeur      Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([organismeId, cle])
}

// =============================================================
//  MODULE DIPLÔMES — suivi & attestation de remise (formations diplômantes)
// =============================================================

enum DiplomeStatut {
  ENVOYE_CERTIFICATEUR // diplôme envoyé au certificateur
  RECU                 // diplôme reçu par l'OF
  REMIS                // diplôme remis au candidat (→ attestation de remise)
}

/// Diplôme d'un candidat pour une session. Les coordonnées peuvent être
/// récupérées depuis l'inscrit (inscriptionId) ou saisies manuellement.
model Diplome {
  id            String   @id @default(cuid())
  organismeId   String? // tenant
  inscriptionId String? // rattachement à l'inscrit (source des coordonnées)
  sessionId     String? // pour le suivi par session
  formationId   String? // pour le suivi par formation
  nom           String
  prenom        String
  dateNaissance DateTime?
  lieuNaissance String?
  numeroDiplome String? // unique par organisme (cf. @@unique) — registre anti-fraude
  statut        DiplomeStatut @default(ENVOYE_CERTIFICATEUR)
  envoyeCertificateurAt DateTime?
  recuAt        DateTime?
  remisAt       DateTime?
  remiseParNom  String? // collaborateur ayant remis le diplôme
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Unicité du n° de diplôme par organisme : un n° préfectoral dupliqué rendrait
  // le 2e titre invérifiable dans le registre anti-fraude. NULL autorisé en
  // multiple (brouillons sans n°). Requiert `prisma db push` (dédoublonner avant). (A06-013)
  @@unique([organismeId, numeroDiplome])
  @@index([organismeId])
  @@index([sessionId])
  @@index([formationId])
  @@index([inscriptionId])
}

// =============================================================
//  MODULE ANTI-FRAUDE — index vérifiable des titres délivrés
// =============================================================

/// Statut de validité d'un titre (exposé par la vérification publique).
enum TitreStatut {
  VALIDE
  EXPIRE
  REVOQUE
  ANNULE
  ARCHIVE
}

/// Titre délivré, indexé pour la vérification publique en ligne
/// (numéro + date de naissance). La date de naissance n'est JAMAIS stockée en
/// clair : seul son hash salé (SHA-256(dob + selUnique)) est conservé, pour
/// comparaison. Aucune liste n'est consultable : accès uniquement par numéro.
model TitreDelivre {
  id                 String      @id @default(cuid())
  organismeId        String // tenant
  typeCode           String // code du catalogue titres (SSIAP1_DIPLOME, HABIL_H0B0, FC_VTC…)
  numeroVerification String // numéro affiché sur le document
  hashDateNaissance  String // SHA-256(dateNaissance_yyyy-mm-dd + selUnique)
  selUnique          String // sel aléatoire par enregistrement
  nomTitulaire       String
  prenomTitulaire    String
  dateDelivrance     DateTime
  dateFinValidite    DateTime? // null si le type n'expire pas (diplômes SSIAP)
  statut             TitreStatut @default(VALIDE)
  organismeSignataire String
  hashPdf            String? // empreinte SHA-256 du PDF délivré (intégrité, optionnel)
  // Rattachements internes (traçabilité ; jamais exposés publiquement)
  inscriptionId String?
  sessionId     String?
  formationId   String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organismeId, numeroVerification])
  @@index([organismeId])
  @@index([sessionId])
  @@index([inscriptionId])
}

// =============================================================
//  MODULE JURY — annuaire, affectation par session, défraiement
// =============================================================

/// Membre de jury (annuaire de l'organisme).
model Jury {
  id          String   @id @default(cuid())
  organismeId String? // tenant
  nom         String
  prenom      String
  email       String?
  telephone   String?
  qualite     String? // fonction / titre (ex. "Formateur expert SSIAP 3")
  // Formations que ce juré peut valider (liste d'identifiants Formation).
  formationsValidables String[]
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  affectations JuryAffectation[]

  @@index([organismeId])
}

enum JuryPaiementStatut {
  A_PAYER
  PAYE
}

/// Affectation d'un juré à une session : prix (défraiement) personnalisé,
/// suivi du paiement et de l'envoi de la note de défraiement.
model JuryAffectation {
  id          String  @id @default(cuid())
  organismeId String? // tenant
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  juryId      String
  jury        Jury    @relation(fields: [juryId], references: [id], onDelete: Cascade)
  prixCents   Int     @default(0) // montant du défraiement (personnalisé)
  natureExamen String? // nature de l'examen (figure sur la note)
  dateExamen  DateTime? // date de l'examen (sinon repli sur la session)
  statut      JuryPaiementStatut @default(A_PAYER)
  payeAt      DateTime?
  defraiementSentAt DateTime? // note de défraiement envoyée au juré
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sessionId, juryId])
  @@index([organismeId])
  @@index([sessionId])
}

/// Messagerie candidat ↔ organisme (portail candidat). Un fil par candidat.
model CandidatMessage {
  id            String   @id @default(cuid())
  organismeId   String? // tenant
  candidatId    String
  candidat      Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  corps         String   @db.Text
  deCandidat    Boolean  @default(true) // true = écrit par le candidat ; false = par l'OF
  auteurNom     String?
  luParOf       Boolean  @default(false) // message du candidat lu par l'OF
  luParCandidat Boolean  @default(true)  // message de l'OF lu par le candidat
  createdAt     DateTime @default(now())

  @@index([candidatId])
  @@index([organismeId])
}

// =============================================================
//  MODULE SITE VITRINE — BLOG & TRAFIC
//  Contenus et analytics du site public capacademy.fr, pilotés depuis
//  la console. Lus par le vitrine via /api/public/blog (ISR ~5 min).
// =============================================================

/// Article de blog / actualité publié sur le site vitrine.
/// Le statut réutilise l'enum VitrineStatut (MASQUEE = brouillon,
/// PUBLIEE = en ligne, SUSPENDUE = retiré temporairement).
/// Jointure vitrine par `slug` (surcouche sur les articles statiques).
model Article {
  id              String        @id @default(cuid())
  organismeId     String? // tenant (multi-OF)
  slug            String // unique PAR organisme (cf. @@unique)
  titre           String
  extrait         String?       @db.Text // résumé court (listing + meta description)
  // Corps en markdown léger : « ## » = sous-titre, « - » = puce, sinon paragraphe.
  contenu         String?       @db.Text
  auteur          String?
  categorie       String? // ex. "Financement", "Sécurité"…
  imageUrl        String?       @db.Text
  imageAlt        String?
  datePublication DateTime      @default(now())
  statut          VitrineStatut @default(MASQUEE)
  isArchived      Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organismeId, slug])
  @@index([organismeId])
  @@index([isArchived])
  @@index([statut])
}

/// Vue de page du site vitrine (analytics privacy-first, sans cookie ni
/// donnée personnelle). Alimentée par un beacon depuis le site public via
/// /api/public/track, scopée par l'env VITRINE_ORGANISME_ID.
model PageVue {
  id          String   @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  path        String // chemin visité, ex. "/formations/securite/sst"
  referer     String? // origine (nom d'hôte du référent), ex. "google.com"
  pays        String? // code pays éventuel (non implémenté par défaut)
  createdAt   DateTime @default(now())

  @@index([organismeId, createdAt])
  @@index([path])
}

enum ZonePhoto {
  CLIENTS_PARTENAIRES // page « Clients & partenaires »
  CENTRE // photos du centre (page « Qui sommes-nous »)
  ALBUM // page « Album photos » (sessions, souvenirs)
}

model PhotoVitrine {
  id          String    @id @default(cuid())
  organismeId String? // tenant (multi-OF)
  zone        ZonePhoto
  url         String    @db.Text
  legende     String? // légende / nom (ex. nom du partenaire, titre de la session)
  ordre       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([organismeId, zone, ordre])
}

// =============================================================
//  MODULE T3P — PARCOURS EXAMEN TAXI / VTC (CMA)
//
//  Suivi complet du parcours d'accès aux professions du transport
//  public particulier de personnes (T3P) : vérification des
//  prérequis, inscription à l'examen CMA, paiement des frais,
//  épreuves théoriques (admissibilité) et pratique (admission),
//  jusqu'à la carte professionnelle préfectorale.
//  Règles CMA : admission dans les 2 mois suivant l'admissibilité ;
//  3 présentations max à l'admission dans un délai d'1 an.
// =============================================================

// Métier visé par le parcours (les passerelles VTC↔Taxi restent un
// parcours du métier CIBLE, avec des frais réduits « mobilité »).
enum T3PMetier {
  TAXI
  VTC
}

enum ParcoursT3PStatut {
  EN_COURS
  REUSSI // épreuve pratique admise (carte professionnelle en cours / obtenue)
  ABANDONNE
}

enum T3PEpreuveType {
  THEORIE // épreuves d'admissibilité (QCM/QRC) — CMA
  PRATIQUE // épreuve d'admission (mise en situation) — CMA
}

enum T3PEpreuveResultat {
  EN_ATTENTE
  ADMIS
  AJOURNE
  ABSENT
}

model ParcoursT3P {
  id          String  @id @default(cuid())
  organismeId String? // tenant (multi-OF)

  candidatId String
  candidat   Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  // Inscription à la session de formation (préparation) si elle existe :
  // permet la synchro du résultat de certification (BPF / taux de réussite).
  inscriptionId String?      @unique
  inscription   Inscription? @relation(fields: [inscriptionId], references: [id])

  metier T3PMetier
  statut ParcoursT3PStatut @default(EN_COURS)
  // Passerelle Taxi↔VTC (mobilité) : épreuves et frais réduits.
  mobilite Boolean @default(false)

  // ── Étape 1 : prérequis réglementaires + dossier + financement ──
  permisBDate         DateTime? // date d'obtention du permis B
  conduiteAccompagnee Boolean   @default(false) // seuil d'ancienneté 2 ans au lieu de 3
  permisVerifieLe     DateTime? // permis contrôlé (validité + ancienneté)
  casierVerifieLe     DateTime? // compatibilité casier confirmée (art. R.3120-8 c. transports)
  psc1VerifieLe       DateTime? // PSC1 en cours de validité (Taxi uniquement)
  medicalDate         DateTime? // date de l'avis médical (médecin agréé préfecture, cerfa 14880)
  medicalVerifieLe    DateTime?
  dossierCompletLe    DateTime? // dossier administratif complet (pièces + expression de besoin + financement)

  // ── Étape 2 : inscription à l'examen (CMA) ──
  cmaDepartement   String? // département / CMA d'inscription
  cmaNumeroDossier String?
  cmaInscritLe     DateTime?

  // ── Étape 3 : paiement des frais d'examen ──
  fraisMontant      Decimal?  @db.Decimal(10, 2) // 241 € en 2026 (168 € mobilité) — réévalués au 1er janvier
  fraisPayesLe      DateTime?
  fraisAvancesParOF Boolean   @default(false) // frais avancés par l'organisme (à refacturer)

  // ── Étapes 4→10 : convocations, épreuves & résultats (une ligne par tentative) ──
  epreuves T3PEpreuve[]

  // Jalons de formation (l'assiduité réelle est portée par la session : émargements)
  formationTheoriqueFaiteLe DateTime?
  formationPratiqueFaiteLe  DateTime?

  // Publication des résultats d'admissibilité : point de départ des délais
  // réglementaires (3 présentations à l'admission dans un délai d'1 an).
  admissibiliteLe DateTime?

  // ── Étape 11 : carte professionnelle (préfecture — Démarches Simplifiées) ──
  carteProDemandeeLe DateTime?
  carteProObtenueLe  DateTime?
  carteProNumero     String?

  commentaire String? @db.Text

  // Validation manuelle des étapes par les collaborateurs (traçabilité Qualiopi).
  // JSON : { "<etapeKey>": { "nom": "<collaborateur>", "userId": "<id>",
  //          "date": "<ISO>", "comment"?: "<note>" } }. Indépendant du statut
  // calculé (dates) : c'est un contrôle/visa explicite porté par un agent.
  etapesValidation Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidatId, metier])
  @@index([organismeId])
  @@index([statut])
}

// Épreuve CMA — une ligne par présentation : convocation, date, résultat.
model T3PEpreuve {
  id          String  @id @default(cuid())
  organismeId String? // tenant (multi-OF)

  parcoursId String
  parcours   ParcoursT3P @relation(fields: [parcoursId], references: [id], onDelete: Cascade)

  type      T3PEpreuveType
  tentative Int            @default(1) // n° de présentation (admission : 3 max)

  convocationRecueLe DateTime? // convocation CMA reçue (archivée en pièce jointe candidat)
  date               DateTime? // date de l'épreuve
  resultat           T3PEpreuveResultat @default(EN_ATTENTE)
  resultatLe         DateTime? // date de publication du résultat
  note               String? // ex. « 14/20 »
  commentaire        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parcoursId, type, tentative])
  @@index([organismeId])
}

// =============================================================
//  Communication & réseaux sociaux — contenus générés par IA pour promouvoir
//  une session (module « communication », activable par organisme). v1 :
//  génération + validation + export (pas de publication automatique).
// =============================================================
enum SocialPlatform {
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  X
  TIKTOK
  YOUTUBE
  WHATSAPP
}

enum SocialAssetType {
  TEXTE
  IMAGE
  VIDEO
}

enum SocialAssetStatut {
  BROUILLON
  A_VALIDER
  APPROUVE
  REJETE
}

model SocialContentAsset {
  id          String @id @default(cuid())
  organismeId String // tenant (multi-OF)

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  type     SocialAssetType @default(TEXTE)

  // Texte : JSON sérialisé { titre, corps, cta, hashtags[], longueur, avertissements[] }.
  // Visuel : URL / data-URL + description.
  contenu String @db.Text

  statut          SocialAssetStatut @default(BROUILLON)
  version         Int               @default(1)
  notesValidation String?           @db.Text

  createdById String?
  valideParId String?
  valideLe    DateTime?

  // Planification éditoriale (v1 : calendrier + rappels, PAS de publication auto).
  scheduledAt DateTime? // date/heure prévue de publication (par l'OF, à la main)
  publishedAt DateTime? // coché « publié » par l'OF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, platform, type])
  @@index([organismeId])
  @@index([sessionId])
  @@index([statut])
  @@index([scheduledAt])
}

// Snapshot MENSUEL du MRR éditeur (console) : base des analytics (courbe MRR,
// waterfall new/expansion/contraction/churn, cohortes). Un enregistrement par
// mois (idempotent), alimenté par le cron /api/cron/mrr-snapshot. `byOrg` garde
// le MRR par organisme pour reconstruire le waterfall entre deux mois.
model MrrSnapshot {
  id        String   @id @default(cuid())
  mois      String   @unique // "AAAA-MM"
  total     Int // MRR total (€)
  actifs    Int
  essais    Int
  byFormule Json // { BASIQUE, MEDIUM, COMPLET } en €
  byOrg     Json // { organismeId: mrr€ }
  createdAt DateTime @default(now())
}

// =============================================================
//  MODULE — CIRCUITS D'AUTOMATISATION (studio visuel no-code)
//  Complète le moteur codé (lib/automation-engine.ts) : chaque OF peut
//  composer ses propres circuits (timeline relative aux dates de session,
//  multi-audience). Évalués EN PLUS des jalons Qualiopi, jamais à leur place.
//  Rien ne part tant qu'un circuit n'est pas `actif`. cf. lib/automation/circuits.ts
// =============================================================

enum CircuitAncre {
  DEBUT // offset relatif à la date de début de session
  FIN // offset relatif à la date de fin de session
}

enum CircuitAudience {
  APPRENANT
  ENTREPRISE
  FORMATEUR
}

enum CircuitActionType {
  EMAIL // e-mail (sujet + corps, balises)
  DOCUMENT // génération + envoi d'un document PDF
  ESIGN // document à signer électroniquement
  EVALUATION // lien d'évaluation / quiz
  SATISFACTION // enquête de satisfaction
  AUTO_EVALUATION // auto-évaluation / positionnement
}

// Un circuit = une suite d'étapes composée par l'OF (multi-tenant : organismeId).
model Circuit {
  id          String        @id @default(cuid())
  organismeId String? // tenant (multi-OF) — injecté par scopedPrisma
  nom         String
  description String?
  actif       Boolean       @default(false) // OFF par défaut : aucun envoi tant que non activé
  steps       CircuitStep[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([organismeId])
  @@index([actif])
}

// Une étape (un « nœud » de la timeline) : quand / à qui / quoi.
model CircuitStep {
  id          String            @id @default(cuid())
  organismeId String? // tenant (multi-OF) — injecté par scopedPrisma
  circuitId   String
  circuit     Circuit           @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  ordre       Int               @default(0)
  ancre       CircuitAncre      @default(DEBUT)
  offsetJours Int               @default(0) // négatif = avant l'ancre, positif = après
  audience    CircuitAudience   @default(APPRENANT)
  typeAction  CircuitActionType
  titre       String? // libellé affiché sur le nœud
  emailSujet  String?
  emailCorps  String?           @db.Text
  documentType String? // type de document (DOCUMENT / ESIGN)
  config      Json? // extension future (canal, pièces jointes…)
  runs        CircuitStepRun[]

  @@index([organismeId])
  @@index([circuitId])
}

// Journal d'exécution : une ligne = une étape exécutée pour une inscription.
// Garantit l'idempotence (l'étape ne repart pas au run suivant du cron).
model CircuitStepRun {
  id            String      @id @default(cuid())
  organismeId   String? // tenant (multi-OF) — injecté par scopedPrisma
  stepId        String
  step          CircuitStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  circuitId     String
  inscriptionId String
  firedAt       DateTime    @default(now())
  statut        String      @default("ENVOYE") // ENVOYE | ECHEC

  @@unique([stepId, inscriptionId])
  @@index([organismeId])
  @@index([inscriptionId])
  @@index([circuitId])
}
