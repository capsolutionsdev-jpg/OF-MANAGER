# OFManager — variables d'environnement (modèle). Copier en `.env` et remplir.
# NE JAMAIS committer de vraie valeur : `.env*` est ignoré (sauf ce fichier `.env.example`).
# Légende : [OBLIG] requis en prod · [OPT] optionnel · [FLAG] active/désactive une fonctionnalité.

# ── Base de données (Neon PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=            # [OBLIG] chaîne pooled Neon (⚠️ dev ≠ prod : utiliser une branche de test en local)
DIRECT_URL=              # [OBLIG] chaîne directe Neon (migrations)
DATABASE_URL_TEST=       # [OPT] base éphémère pour les tests d'intégration/isolation (auto-skip si absent)

# ── Authentification (NextAuth v5) ────────────────────────────────────────────
AUTH_SECRET=             # [OBLIG] openssl rand -base64 32 (⚠️ le changer déconnecte tout le monde)
ENFORCE_ADMIN_2FA=       # [FLAG] "1" pour imposer la 2FA aux ADMIN/SUPERADMIN

# ── Chiffrement des secrets par OF (clés API tenant) ──────────────────────────
SECRETS_ENCRYPTION_KEY=  # [OBLIG] clé AES-256 (32 octets). Sans elle, les clés API par OF sont illisibles.

# ── URLs & tenant vitrine ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ofmanager.info   # [OBLIG] domaine canonique public
APP_URL=https://ofmanager.info                # [OPT] repli si NEXT_PUBLIC_SITE_URL absent
VITRINE_ORGANISME_ID=    # [OBLIG] id de l'organisme éditeur (facturation, émetteur des factures)
CIVIC_ORGANISME_ID=      # [OPT] tenant du produit examen civique

# ── E-mail transactionnel (Resend prioritaire ; Brevo = repli UE) ─────────────
RESEND_API_KEY=          # [OBLIG*] clé Resend (ou Brevo ci-dessous)
RESEND_SENDER=           # [OBLIG*] expéditeur vérifié, ex. "OFManager <no-reply@ofmanager.info>"
RESEND_WEBHOOK_SECRET=   # [OPT] secret Svix (tracking + bounces)
BREVO_API_KEY=           # [OPT] repli / résidence UE
BREVO_SENDER=            # [OPT] expéditeur Brevo
BREVO_SMS_SENDER=        # [OPT] émetteur SMS
BREVO_WEBHOOK_SECRET=    # [OPT] secret webhook Brevo (?secret=...)

# ── Notifications internes (e-mails staff) ────────────────────────────────────
LEAD_NOTIF_EMAIL=        # [OPT] destinataire des nouveaux leads
DEMO_NOTIFY_EMAIL=       # [OPT] alertes provisionnement démo
DEMO_CONTACT_EMAIL=      # [OPT] contact démo
SUPPORT_NOTIFY_EMAIL=    # [OPT] alertes nouveaux tickets support

# ── Rate-limit partagé (Upstash Redis) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=  # [OBLIG] sinon rate-limit mémoire par-instance (contournable ; l'IA fail-close en prod)
UPSTASH_REDIS_REST_TOKEN=

# ── Sécurité endpoints publics ────────────────────────────────────────────────
CRON_SECRET=             # [OBLIG] protège /api/cron/* (Vercel envoie Authorization: Bearer <CRON_SECRET>)
LEAD_API_SECRET=         # [OPT] protège l'endpoint public de leads
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # [OPT] Cloudflare Turnstile (anti-bot formulaires)
TURNSTILE_SECRET_KEY=

# ── Stripe (abonnement au SaaS) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=       # [OBLIG] clé secrète Stripe
STRIPE_WEBHOOK_SECRET=   # [OBLIG] secret de signature du webhook
STRIPE_TVA_TAX_RATE_ID=  # [OPT] id du TaxRate TVA 20 % (sinon créé auto au 1er paiement — cf. lot P5)

# ── IA (génération de contenus) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=       # [OPT] clé Claude (module communication / IA)
AI_MODEL=                # [OPT] override du modèle (défaut Haiku)
OPENAI_API_KEY=          # [OPT]
IMAGE_API_KEY=           # [OPT] génération d'images

# ── E-signature / CPF / facturation électronique (PDP 2026) ───────────────────
YOUSIGN_API_KEY=         # [OPT] Yousign (flux v3 NON branché à ce jour → signature interne)
PDP_PROVIDER=            # [OPT] plateforme de dématérialisation (Factur-X)
PDP_API_URL=
PDP_API_KEY=

# ── Push mobile & stockage fichiers ───────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=   # [OPT] JSON service account (push)
PUSH_ENABLED=               # [FLAG] "1" pour activer le push (no-op sûr sinon)
BLOB_READ_WRITE_TOKEN=      # [OBLIG] Vercel Blob (documents, pièces jointes)

# ── Observabilité & analytics ─────────────────────────────────────────────────
SENTRY_DSN=                 # [OPT mais reco] active reportError (crons/webhooks/PDF — lot P1)
NEXT_PUBLIC_SENTRY_DSN=     # [OPT] DSN côté client
SENTRY_TRACES_SAMPLE_RATE=  # [OPT] taux d'échantillonnage
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=   # [OPT] analytics
NEXT_PUBLIC_GSC_VERIFICATION=   # [OPT] Google Search Console

# ── Identité légale de l'éditeur (mentions, CGV, factures) — décision 2 ───────
NEXT_PUBLIC_LEGAL_RAISON_SOCIALE=   # défaut "CAP SOLUTIONS"
NEXT_PUBLIC_LEGAL_FORME=            # défaut "SASU"
NEXT_PUBLIC_LEGAL_CAPITAL=          # défaut "100 €"
NEXT_PUBLIC_LEGAL_SIRET=            # [À POSER dès immatriculation]
NEXT_PUBLIC_LEGAL_RCS=              # [À POSER dès immatriculation]
NEXT_PUBLIC_LEGAL_TVA=              # [À POSER dès immatriculation]
NEXT_PUBLIC_LEGAL_ADRESSE=
NEXT_PUBLIC_LEGAL_DIRECTEUR=
NEXT_PUBLIC_LEGAL_TEL=
NEXT_PUBLIC_LEGAL_EMAIL=            # défaut "contact@ofmanager.info"
NEXT_PUBLIC_LEGAL_HEBERGEUR=

# ── Flags & divers ────────────────────────────────────────────────────────────
RLS_ENABLED=             # [FLAG] active la RLS Postgres (défaut OFF ; voir docs/RLS-ACTIVATION.md)
RLS_STRICT=              # [FLAG]
CSP_NONCE=               # [FLAG] active le nonce CSP (retire 'unsafe-inline')

# ── Seed / démo (⚠️ à ne PAS activer sur une base réelle) ─────────────────────
ADMIN_EMAIL=             # compte admin créé par le seed
ADMIN_PASSWORD=          # sinon mot de passe aléatoire fort généré + affiché une fois
SEED_DEMO=               # [FLAG] "1" pour injecter des candidats de démo (dev uniquement)
DEMO_TTL_HOURS=          # durée de vie d'un tenant démo (défaut 48)
DEMO_HARD_TTL_DAYS=      # filet dur (défaut 7)
